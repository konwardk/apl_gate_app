VIEW GateService_WeighbridgeTransactions AS SELECT
  WeighbridgeTransactions_0.ID,
  WeighbridgeTransactions_0.createdAt,
  WeighbridgeTransactions_0.createdBy,
  WeighbridgeTransactions_0.modifiedAt,
  WeighbridgeTransactions_0.modifiedBy,
  WeighbridgeTransactions_0.gateTransaction_ID,
  WeighbridgeTransactions_0.weighbridgeNumber,
  WeighbridgeTransactions_0.weighmentType,
  WeighbridgeTransactions_0.weight,
  WeighbridgeTransactions_0.weightUnit,
  WeighbridgeTransactions_0.weighbridgeDateTime,
  WeighbridgeTransactions_0.operator,
  WeighbridgeTransactions_0.remarks
FROM factory_gate_WeighbridgeTransactions AS WeighbridgeTransactions_0