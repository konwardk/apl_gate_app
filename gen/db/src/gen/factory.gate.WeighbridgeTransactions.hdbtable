COLUMN TABLE factory_gate_WeighbridgeTransactions (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  gateTransaction_ID NVARCHAR(36) NOT NULL,
  weighbridgeNumber NVARCHAR(30),
  weighmentType NVARCHAR(5000),
  weight DECIMAL(15, 3),
  weightUnit NVARCHAR(5000) DEFAULT 'KG',
  weighbridgeDateTime TIMESTAMP,
  operator NVARCHAR(100),
  remarks NVARCHAR(250),
  PRIMARY KEY(ID)
)