VIEW GateService_Users AS SELECT
  Users_0.ID,
  Users_0.createdAt,
  Users_0.createdBy,
  Users_0.modifiedAt,
  Users_0.modifiedBy,
  Users_0.UserId,
  Users_0.username,
  Users_0.password,
  Users_0.name,
  Users_0.employeeId,
  Users_0.designation,
  Users_0.department,
  Users_0.email,
  Users_0.phoneNo,
  Users_0.serviceStatus,
  Users_0.status,
  Users_0.active,
  Users_0.assignedRoles,
  Users_0.remarks
FROM factory_gate_Users AS Users_0