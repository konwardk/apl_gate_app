COLUMN TABLE factory_gate_FactoryGateEntries (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  gateTransaction_ID NVARCHAR(36) NOT NULL,
  gateInNumber NVARCHAR(30),
  factoryGateInDateTime TIMESTAMP,
  factoryGateInOperator NVARCHAR(100),
  factoryGateInRemarks NVARCHAR(500),
  factoryGateOutDateTime TIMESTAMP,
  factoryGateOutOperator NVARCHAR(100),
  factoryGateOutRemarks NVARCHAR(500),
  gateOutType NVARCHAR(50),
  poNumber NVARCHAR(30),
  invoiceNumber NVARCHAR(50),
  invoiceDate DATE,
  supplierName NVARCHAR(100),
  transporterName NVARCHAR(100),
  deliveryNoteNo NVARCHAR(50),
  factoryArea NVARCHAR(100),
  unloadingPoint NVARCHAR(100),
  materialDescription NVARCHAR(200),
  unloadingStatus NVARCHAR(30) DEFAULT 'COMPLETED',
  unloadedQuantity DECIMAL(15, 3),
  quantityUnit NVARCHAR(10) DEFAULT 'KG',
  goodsInspected BOOLEAN DEFAULT TRUE,
  sealVerified BOOLEAN DEFAULT TRUE,
  remarks NVARCHAR(500),
  PRIMARY KEY(ID)
)