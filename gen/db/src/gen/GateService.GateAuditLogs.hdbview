VIEW GateService_GateAuditLogs AS SELECT
  GateAuditLogs_0.ID,
  GateAuditLogs_0.gateTransaction_ID,
  GateAuditLogs_0.action,
  GateAuditLogs_0.oldStatus,
  GateAuditLogs_0.newStatus,
  GateAuditLogs_0.oldStage,
  GateAuditLogs_0.newStage,
  GateAuditLogs_0.actionDateTime,
  GateAuditLogs_0.userId,
  GateAuditLogs_0.userName,
  GateAuditLogs_0.remarks
FROM factory_gate_GateAuditLogs AS GateAuditLogs_0