COLUMN TABLE factory_gate_GateTransactions (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  gateInNumber NVARCHAR(30),
  vehicleRegNo NVARCHAR(20),
  vehicleType NVARCHAR(5000) DEFAULT 'TRUCK',
  driverName NVARCHAR(100),
  purpose NVARCHAR(5000),
  status NVARCHAR(5000) DEFAULT 'GATE_IN',
  currentStage NVARCHAR(5000) DEFAULT 'MAIN_GATE_IN',
  gateInDateTime TIMESTAMP,
  gateInOperator NVARCHAR(100),
  gateOutDateTime TIMESTAMP,
  gateOutOperator NVARCHAR(100),
  remarks NVARCHAR(500),
  assignedRoute NVARCHAR(50),
  driver_ID NVARCHAR(36),
  transporter_ID NVARCHAR(36),
  supplier_ID NVARCHAR(36),
  PRIMARY KEY(ID)
)