VIEW GateService_GateTransactions AS SELECT
  GateTransactions_0.ID,
  GateTransactions_0.createdAt,
  GateTransactions_0.createdBy,
  GateTransactions_0.modifiedAt,
  GateTransactions_0.modifiedBy,
  GateTransactions_0.gateInNumber,
  GateTransactions_0.vehicleRegNo,
  GateTransactions_0.vehicleType,
  GateTransactions_0.driverName,
  GateTransactions_0.purpose,
  GateTransactions_0.status,
  GateTransactions_0.currentStage,
  GateTransactions_0.gateInDateTime,
  GateTransactions_0.gateInOperator,
  GateTransactions_0.gateOutDateTime,
  GateTransactions_0.gateOutOperator,
  GateTransactions_0.remarks,
  GateTransactions_0.assignedRoute,
  GateTransactions_0.driver_ID,
  GateTransactions_0.transporter_ID,
  GateTransactions_0.supplier_ID
FROM factory_gate_GateTransactions AS GateTransactions_0