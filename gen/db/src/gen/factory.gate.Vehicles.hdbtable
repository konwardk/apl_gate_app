COLUMN TABLE factory_gate_Vehicles (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  vehicleRegNo NVARCHAR(20),
  vehicleType NVARCHAR(5000),
  vehicleCategory NVARCHAR(30),
  make NVARCHAR(50),
  model NVARCHAR(50),
  capacity DECIMAL(15, 3),
  capacityUnit NVARCHAR(5000),
  transporter_ID NVARCHAR(36),
  insuranceNo NVARCHAR(50),
  insuranceExpiry DATE,
  fitnessCertificateNo NVARCHAR(50),
  fitnessExpiry DATE,
  pollutionCertificateNo NVARCHAR(50),
  pollutionExpiry DATE,
  permitNo NVARCHAR(50),
  permitExpiry DATE,
  active BOOLEAN DEFAULT TRUE,
  PRIMARY KEY(ID)
)