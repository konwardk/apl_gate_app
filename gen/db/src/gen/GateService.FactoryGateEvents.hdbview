VIEW GateService_FactoryGateEvents AS SELECT
  FactoryGateEntries_0.ID,
  FactoryGateEntries_0.createdAt,
  FactoryGateEntries_0.createdBy,
  FactoryGateEntries_0.modifiedAt,
  FactoryGateEntries_0.modifiedBy,
  FactoryGateEntries_0.gateTransaction_ID,
  FactoryGateEntries_0.gateInNumber,
  FactoryGateEntries_0.factoryGateInDateTime,
  FactoryGateEntries_0.factoryGateInOperator,
  FactoryGateEntries_0.factoryGateInRemarks,
  FactoryGateEntries_0.factoryGateOutDateTime,
  FactoryGateEntries_0.factoryGateOutOperator,
  FactoryGateEntries_0.factoryGateOutRemarks,
  FactoryGateEntries_0.gateOutType,
  FactoryGateEntries_0.poNumber,
  FactoryGateEntries_0.invoiceNumber,
  FactoryGateEntries_0.invoiceDate,
  FactoryGateEntries_0.supplierName,
  FactoryGateEntries_0.transporterName,
  FactoryGateEntries_0.deliveryNoteNo,
  FactoryGateEntries_0.factoryArea,
  FactoryGateEntries_0.unloadingPoint,
  FactoryGateEntries_0.materialDescription,
  FactoryGateEntries_0.unloadingStatus,
  FactoryGateEntries_0.unloadedQuantity,
  FactoryGateEntries_0.quantityUnit,
  FactoryGateEntries_0.goodsInspected,
  FactoryGateEntries_0.sealVerified,
  FactoryGateEntries_0.remarks
FROM factory_gate_FactoryGateEntries AS FactoryGateEntries_0