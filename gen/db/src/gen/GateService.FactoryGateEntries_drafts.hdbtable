COLUMN TABLE GateService_FactoryGateEntries_drafts (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  gateTransaction_ID NVARCHAR(36) NULL,
  gateInNumber NVARCHAR(30) NULL,
  factoryGateInDateTime TIMESTAMP NULL,
  factoryGateInOperator NVARCHAR(100) NULL,
  factoryGateInRemarks NVARCHAR(500) NULL,
  factoryGateOutDateTime TIMESTAMP NULL,
  factoryGateOutOperator NVARCHAR(100) NULL,
  factoryGateOutRemarks NVARCHAR(500) NULL,
  gateOutType NVARCHAR(50) NULL,
  poNumber NVARCHAR(30) NULL,
  invoiceNumber NVARCHAR(50) NULL,
  invoiceDate DATE NULL,
  supplierName NVARCHAR(100) NULL,
  transporterName NVARCHAR(100) NULL,
  deliveryNoteNo NVARCHAR(50) NULL,
  factoryArea NVARCHAR(100) NULL,
  unloadingPoint NVARCHAR(100) NULL,
  materialDescription NVARCHAR(200) NULL,
  unloadingStatus NVARCHAR(30) NULL DEFAULT 'COMPLETED',
  unloadedQuantity DECIMAL(15, 3) NULL,
  quantityUnit NVARCHAR(10) NULL DEFAULT 'KG',
  goodsInspected BOOLEAN NULL DEFAULT TRUE,
  sealVerified BOOLEAN NULL DEFAULT TRUE,
  remarks NVARCHAR(500) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)