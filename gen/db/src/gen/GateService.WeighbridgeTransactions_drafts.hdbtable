COLUMN TABLE GateService_WeighbridgeTransactions_drafts (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  gateTransaction_ID NVARCHAR(36) NULL,
  weighbridgeNumber NVARCHAR(30) NULL,
  weighmentType NVARCHAR(5000) NULL,
  weight DECIMAL(15, 3) NULL,
  weightUnit NVARCHAR(5000) NULL DEFAULT 'KG',
  weighbridgeDateTime TIMESTAMP NULL,
  operator NVARCHAR(100) NULL,
  remarks NVARCHAR(250) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)