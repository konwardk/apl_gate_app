VIEW GateService_SecurityGateExits AS SELECT
  SecurityGateEntries_0.ID,
  SecurityGateEntries_0.createdAt,
  SecurityGateEntries_0.createdBy,
  SecurityGateEntries_0.modifiedAt,
  SecurityGateEntries_0.modifiedBy,
  SecurityGateEntries_0.gateTransaction_ID,
  SecurityGateEntries_0.gateInNumber,
  SecurityGateEntries_0.driverLicenseNo,
  SecurityGateEntries_0.driverPhoneNo,
  SecurityGateEntries_0.helperName,
  SecurityGateEntries_0.vehicleReportingDateTime,
  SecurityGateEntries_0.securityInDateTime,
  SecurityGateEntries_0.securityPersonnel,
  SecurityGateEntries_0.driverVerified,
  SecurityGateEntries_0.vehicleVerified,
  SecurityGateEntries_0.documentsVerified,
  SecurityGateEntries_0.poNumber,
  SecurityGateEntries_0.soNumber,
  SecurityGateEntries_0.invoiceNumber,
  SecurityGateEntries_0.invoiceDate,
  SecurityGateEntries_0.withoutPO,
  SecurityGateEntries_0.rgpDocumentNo,
  SecurityGateEntries_0.nrgpDocumentNo,
  SecurityGateEntries_0.gatePassType,
  SecurityGateEntries_0.assignedRoute,
  SecurityGateEntries_0.securityInRemarks,
  SecurityGateEntries_0.securityOutPersonnel,
  SecurityGateEntries_0.securityOutDateTime,
  SecurityGateEntries_0.exitDriverVerified,
  SecurityGateEntries_0.exitVehicleVerified,
  SecurityGateEntries_0.exitDocumentsVerified,
  SecurityGateEntries_0.gatePassVerified,
  SecurityGateEntries_0.deliveryDetailsVerified,
  SecurityGateEntries_0.emptyInspectionVerified,
  SecurityGateEntries_0.materialInspected,
  SecurityGateEntries_0.exitGatePassType,
  SecurityGateEntries_0.exitGatePassDocumentNo,
  SecurityGateEntries_0.securityOutRemarks,
  SecurityGateEntries_0.remarks
FROM factory_gate_SecurityGateEntries AS SecurityGateEntries_0