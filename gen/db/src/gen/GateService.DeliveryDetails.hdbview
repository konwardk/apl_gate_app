VIEW GateService_DeliveryDetails AS SELECT
  DeliveryDetails_0.ID,
  DeliveryDetails_0.createdAt,
  DeliveryDetails_0.createdBy,
  DeliveryDetails_0.modifiedAt,
  DeliveryDetails_0.modifiedBy,
  DeliveryDetails_0.gateTransaction_ID,
  DeliveryDetails_0.poNumber,
  DeliveryDetails_0.poItem,
  DeliveryDetails_0.soNumber,
  DeliveryDetails_0.soItem,
  DeliveryDetails_0.invoiceNumber,
  DeliveryDetails_0.invoiceDate,
  DeliveryDetails_0.deliveryNumber,
  DeliveryDetails_0.deliveryDate,
  DeliveryDetails_0.supplierCode,
  DeliveryDetails_0.supplierName,
  DeliveryDetails_0.documentVerificationStatus,
  DeliveryDetails_0.remarks
FROM factory_gate_DeliveryDetails AS DeliveryDetails_0