COLUMN TABLE GateService_DeliveryDetails_drafts (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  gateTransaction_ID NVARCHAR(36) NULL,
  poNumber NVARCHAR(20) NULL,
  poItem NVARCHAR(10) NULL,
  soNumber NVARCHAR(20) NULL,
  soItem NVARCHAR(10) NULL,
  invoiceNumber NVARCHAR(30) NULL,
  invoiceDate DATE NULL,
  deliveryNumber NVARCHAR(20) NULL,
  deliveryDate DATE NULL,
  supplierCode NVARCHAR(20) NULL,
  supplierName NVARCHAR(100) NULL,
  documentVerificationStatus NVARCHAR(5000) NULL DEFAULT 'PENDING',
  remarks NVARCHAR(500) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)