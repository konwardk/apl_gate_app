VIEW GateService_PickupDetails AS SELECT
  PickupDetails_0.ID,
  PickupDetails_0.createdAt,
  PickupDetails_0.createdBy,
  PickupDetails_0.modifiedAt,
  PickupDetails_0.modifiedBy,
  PickupDetails_0.gateTransaction_ID,
  PickupDetails_0.gatePassType,
  PickupDetails_0.gatePassDocumentNo,
  PickupDetails_0.gatePassDocumentDate,
  PickupDetails_0.pickupPurpose,
  PickupDetails_0.authorizedBy,
  PickupDetails_0.gatePassVerified,
  PickupDetails_0.remarks
FROM factory_gate_PickupDetails AS PickupDetails_0