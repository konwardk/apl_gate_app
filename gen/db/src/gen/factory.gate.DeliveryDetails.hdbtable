COLUMN TABLE factory_gate_DeliveryDetails (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  gateTransaction_ID NVARCHAR(36) NOT NULL,
  poNumber NVARCHAR(20),
  poItem NVARCHAR(10),
  soNumber NVARCHAR(20),
  soItem NVARCHAR(10),
  invoiceNumber NVARCHAR(30),
  invoiceDate DATE,
  deliveryNumber NVARCHAR(20),
  deliveryDate DATE,
  supplierCode NVARCHAR(20),
  supplierName NVARCHAR(100),
  documentVerificationStatus NVARCHAR(5000) DEFAULT 'PENDING',
  remarks NVARCHAR(500),
  PRIMARY KEY(ID)
)