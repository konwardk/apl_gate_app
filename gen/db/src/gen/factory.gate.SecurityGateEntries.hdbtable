COLUMN TABLE factory_gate_SecurityGateEntries (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  gateTransaction_ID NVARCHAR(36) NOT NULL,
  gateInNumber NVARCHAR(30),
  driverLicenseNo NVARCHAR(30),
  driverPhoneNo NVARCHAR(20),
  helperName NVARCHAR(100),
  vehicleReportingDateTime TIMESTAMP,
  securityInDateTime TIMESTAMP,
  securityPersonnel NVARCHAR(100),
  driverVerified BOOLEAN DEFAULT FALSE,
  vehicleVerified BOOLEAN DEFAULT FALSE,
  documentsVerified BOOLEAN DEFAULT FALSE,
  poNumber NVARCHAR(30),
  soNumber NVARCHAR(30),
  invoiceNumber NVARCHAR(50),
  invoiceDate DATE,
  withoutPO BOOLEAN DEFAULT FALSE,
  rgpDocumentNo NVARCHAR(30),
  nrgpDocumentNo NVARCHAR(30),
  gatePassType NVARCHAR(5000),
  assignedRoute NVARCHAR(50),
  securityInRemarks NVARCHAR(500),
  securityOutPersonnel NVARCHAR(100),
  securityOutDateTime TIMESTAMP,
  exitDriverVerified BOOLEAN DEFAULT FALSE,
  exitVehicleVerified BOOLEAN DEFAULT FALSE,
  exitDocumentsVerified BOOLEAN DEFAULT FALSE,
  gatePassVerified BOOLEAN DEFAULT FALSE,
  deliveryDetailsVerified BOOLEAN DEFAULT FALSE,
  emptyInspectionVerified BOOLEAN DEFAULT FALSE,
  materialInspected BOOLEAN DEFAULT FALSE,
  exitGatePassType NVARCHAR(5000),
  exitGatePassDocumentNo NVARCHAR(30),
  securityOutRemarks NVARCHAR(500),
  remarks NVARCHAR(500),
  PRIMARY KEY(ID)
)