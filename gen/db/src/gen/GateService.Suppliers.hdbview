VIEW GateService_Suppliers AS SELECT
  Suppliers_0.ID,
  Suppliers_0.createdAt,
  Suppliers_0.createdBy,
  Suppliers_0.modifiedAt,
  Suppliers_0.modifiedBy,
  Suppliers_0.supplierCode,
  Suppliers_0.supplierName,
  Suppliers_0.gstin,
  Suppliers_0.contactPerson,
  Suppliers_0.phoneNo,
  Suppliers_0.address,
  Suppliers_0.sapBusinessPartner,
  Suppliers_0.active
FROM factory_gate_Suppliers AS Suppliers_0