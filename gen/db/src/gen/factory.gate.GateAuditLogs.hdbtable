COLUMN TABLE factory_gate_GateAuditLogs (
  ID NVARCHAR(36) NOT NULL,
  gateTransaction_ID NVARCHAR(36),
  action NVARCHAR(50),
  oldStatus NVARCHAR(5000),
  newStatus NVARCHAR(5000),
  oldStage NVARCHAR(5000),
  newStage NVARCHAR(5000),
  actionDateTime TIMESTAMP,
  userId NVARCHAR(100),
  userName NVARCHAR(100),
  remarks NVARCHAR(500),
  PRIMARY KEY(ID)
)