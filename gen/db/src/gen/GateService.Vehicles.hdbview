VIEW GateService_Vehicles AS SELECT
  Vehicles_0.ID,
  Vehicles_0.createdAt,
  Vehicles_0.createdBy,
  Vehicles_0.modifiedAt,
  Vehicles_0.modifiedBy,
  Vehicles_0.vehicleRegNo,
  Vehicles_0.vehicleType,
  Vehicles_0.vehicleCategory,
  Vehicles_0.make,
  Vehicles_0.model,
  Vehicles_0.capacity,
  Vehicles_0.capacityUnit,
  Vehicles_0.transporter_ID,
  Vehicles_0.insuranceNo,
  Vehicles_0.insuranceExpiry,
  Vehicles_0.fitnessCertificateNo,
  Vehicles_0.fitnessExpiry,
  Vehicles_0.pollutionCertificateNo,
  Vehicles_0.pollutionExpiry,
  Vehicles_0.permitNo,
  Vehicles_0.permitExpiry,
  Vehicles_0.active
FROM factory_gate_Vehicles AS Vehicles_0