<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Popover
        title="User Profile &amp; Active Session"
        placement="Bottom"
        contentWidth="330px"
        class="sapUiContentPadding">
        <content>
            <VBox class="sapUiTinyMargin">
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Avatar
                        initials="{/userInitials}"
                        backgroundColor="{/userAvatarColor}"
                        displaySize="M"
                        class="sapUiSmallMarginEnd" />
                    <VBox>
                        <Title text="{/userName}" level="H4" titleStyle="H5" />
                        <Text text="{/userDesignation}" class="text-muted sapUiTinyMarginTop" />
                    </VBox>
                </HBox>

                <VBox class="profile-info-box sapUiSmallMarginBottom">
                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                        <Label text="Username" design="Bold" />
                        <Text text="{/activeUser}" class="fiori-text-strong" />
                    </HBox>
                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom" visible="{= !!${/userEmployeeId} }">
                        <Label text="Employee ID" design="Bold" />
                        <Text text="{/userEmployeeId}" />
                    </HBox>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                        <Label text="Primary Role" design="Bold" />
                        <ObjectStatus text="{/userPrimaryRoleTitle}" state="Information" inverted="true" />
                    </HBox>
                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                        <Label text="Assigned Workspace" design="Bold" />
                        <Text text="{/assignedScreenTitle}" />
                    </HBox>
                    <VBox visible="{= !!${/userRolesText} }">
                        <Label text="All Assigned Roles" design="Bold" />
                        <Text text="{/userRolesText}" class="text-hint sapUiTinyMarginTop" />
                    </VBox>
                </VBox>

                <HBox justifyContent="End">
                    <Button
                        id="idPopoverSignOutBtn"
                        text="Sign Out"
                        icon="sap-icon://log-out"
                        type="Reject"
                        width="100%"
                        press=".onSignOutPress" />
                </HBox>
            </VBox>
        </content>
    </Popover>
</core:FragmentDefinition>
