<mvc:View
    controllerName="factory.gate.controller.Operations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page showHeader="false" enableScrolling="true">
        <!-- Subtoolbar -->
        <OverflowToolbar class="fe-subtoolbar">
            <Button
                text="Back to Launchpad"
                icon="sap-icon://nav-back"
                type="Emphasized"
                press=".onNavBack" />
            <ToolbarSpacer />
            <Title text="Main Gate Operations &amp; Vehicle Check-In" level="H2" titleStyle="H3" />
            <ToolbarSpacer />
            <Button
                text="Security Gate"
                icon="sap-icon://shield"
                type="Default"
                visible="{/canViewSecurityGateOps}"
                press=".onNavSecurityGateOps" />
            <Button
                text="Weighbridge"
                icon="sap-icon://dimension"
                type="Default"
                visible="{/canViewWeighbridgeOps}"
                press=".onNavWeighbridgeOps" />
            <Button
                text="Factory Gate"
                icon="sap-icon://factory"
                type="Default"
                visible="{/canViewFactoryGateOps}"
                press=".onNavFactoryGateOps" />
            <Button
                text="Gate IN"
                icon="sap-icon://log-in"
                type="Emphasized"
                tooltip="Register New Vehicle Entry"
                visible="{/canCreateGateIn}"
                press=".onOpenGateIn" />
            <Button
                text="Gate Exit"
                icon="sap-icon://log-out"
                type="Success"
                tooltip="Authorize Final Vehicle Exit"
                visible="{/canMainGateOut}"
                press=".onOpenGateOut" />
        </OverflowToolbar>

        <!-- Main Content -->
        <VBox class="flp-dashboard">
            <MessageStrip
                text="Main Gate station: Manage vehicle entries, monitor plant progression, and record exit clearance."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Active Transactions Table -->
            <Table
                id="quickTxTable"
                growing="true"
                growingThreshold="20"
                items="{/transactions}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Gate Entries ({= ${/transactions} ? ${/transactions}.length : 0 })" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="opsFilterSegmentedBtn"
                            selectedKey="ALL"
                            selectionChange=".onFilterCategoryChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All ({= ${/counts/TOTAL} || 0 })" />
                                <SegmentedButtonItem key="GATE_IN" text="IN ({= ${/counts/GATE_IN} || 0 })" />
                                <SegmentedButtonItem key="IN_PLANT" text="In Plant ({= ${/counts/IN_PLANT} || 0 })" />
                                <SegmentedButtonItem key="READY_OUT" text="Ready Exit ({= ${/counts/READY_OUT} || 0 })" />
                                <SegmentedButtonItem key="COMPLETED" text="Exit ({= ${/counts/COMPLETED} || 0 })" />
                            </items>
                        </SegmentedButton>
                        <SearchField
                            id="opsSearchField"
                            width="240px"
                            placeholder="Search Vehicle, Pass, Driver..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search &amp; Filters"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Gate Entries Queue"
                            press=".onRefreshQueue" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="220px"><header><Text text="Vehicle / Pass" /></header></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><header><Text text="Driver" /></header></Column>
                    <Column width="160px"><header><Text text="Status / Stage" /></header></Column>
                    <Column width="180px" minScreenWidth="Desktop" demandPopin="true"><header><Text text="Time (IN / Exit)" /></header></Column>
                    <Column hAlign="End" width="200px"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTxRowPress">
                        <cells>
                            <ObjectIdentifier
                                title="{vehicleRegNo}"
                                text="{gateInNumber} • {path: 'purpose', formatter: '.formatter.getPurposeText'}" />
                            <Text text="{= ${driverName} || '-' }" />
                            <VBox>
                                <ObjectStatus
                                    text="{path: 'status', formatter: '.formatter.getStatusText'}"
                                    state="{path: 'status', formatter: '.formatter.getStatusState'}" />
                                <Text
                                    text="{path: 'currentStage', formatter: '.formatter.getStageText'}"
                                    class="sapUiTinyMarginTop text-muted" />
                            </VBox>
                            <VBox>
                                <Text text="{path: 'gateInDateTime', formatter: '.formatter.formatDateTime'}" />
                                <Text
                                    text="{path: 'gateOutDateTime', formatter: '.formatter.formatDateTime'}"
                                    visible="{= !!${gateOutDateTime} }"
                                    class="sapUiTinyMarginTop text-muted" />
                            </VBox>
                            <HBox justifyContent="End" alignItems="Center" wrap="NoWrap" class="sapUiTinyMarginBeginEnd">
                                <!-- Final Exit button: ONLY shown and clickable if all other operations are performed completely (status: SECURITY_OUT) -->
                                <Button
                                    text="Exit"
                                    icon="sap-icon://log-out"
                                    type="Success"
                                    tooltip="Authorize and record final Main Gate Exit clearance"
                                    visible="{= ${status} === 'SECURITY_OUT' }"
                                    enabled="{= ${status} === 'SECURITY_OUT' }"
                                    press=".onRowGateOutPress"
                                    class="sapUiTinyMarginEnd" />

                                <!-- Exited Status Badge -->
                                <ObjectStatus
                                    text="Exited"
                                    state="Success"
                                    icon="sap-icon://sys-enter-2"
                                    visible="{= ${status} === 'COMPLETED' }"
                                    class="sapUiTinyMarginEnd" />

                                <Button
                                    icon="sap-icon://print"
                                    type="Transparent"
                                    tooltip="Print Gate Pass"
                                    press=".onTxPrintPress" />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit Gate Entry"
                                    press=".onTxEditPress" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete Gate Entry"
                                    visible="{= ${status} === 'GATE_IN' || ${status} === 'CANCELLED' }"
                                    press=".onTxDeletePress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
