<mvc:View
    controllerName="factory.gate.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">
    <VBox fitContainer="true" height="100%" class="app-root-container">
        <!-- Secure Enterprise Fiori Shell ToolHeader -->
        <tnt:ToolHeader class="fiori-shellbar">
            <Image
                src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg"
                height="24px"
                press=".onHomePressed"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
            <Image
                src="/images/APL_Logo.jpg"
                height="38px"
                press=".onHomePressed"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd" />
            <Title text="APL Gate In - Gate Out" level="H2" class="sapUiTinyMarginEnd" />
            <Text text="" class="sapUiTinyMarginEnd text-muted" />
            <ToolbarSpacer />

            <!-- Authenticated Workspace Navigation -->
            <Button
                text="{/assignedScreenTitle}"
                icon="{/assignedScreenIcon}"
                type="Emphasized"
                tooltip="Go to your assigned operational workspace"
                visible="{= ${/isAuthenticated} &amp;&amp; ${/assignedScreen} !== 'launchpadPage' }"
                press=".onAssignedWorkspaceNav"
                class="sapUiTinyMarginEnd" />

            <Button
                text="Dashboard"
                icon="sap-icon://home"
                type="Transparent"
                tooltip="Launchpad Operations Dashboard"
                visible="{/isAuthenticated}"
                press=".onLaunchpadNav" />

            <Button
                text="Vehicle Stream"
                icon="sap-icon://shipping-status"
                type="Transparent"
                tooltip="Vehicle Category Stream Selection"
                visible="{= ${/isAuthenticated} &amp;&amp; ${/canViewGateOps} }"
                press=".onVehicleSelectionNav" />

            <Button
                text="User Management"
                icon="sap-icon://user-settings"
                type="Transparent"
                tooltip="Superadmin User &amp; Role Management"
                visible="{= ${/isAuthenticated} &amp;&amp; ${/canManageUsers} }"
                press=".onUserManagementNav" />

            <Button
                text="Reports"
                icon="sap-icon://pdf-attachment"
                type="Transparent"
                tooltip="Operational Reports &amp; Export (PDF / CSV)"
                visible="{= ${/isAuthenticated} &amp;&amp; ${/canViewReports} }"
                press=".onReportsNav" />

            <ToolbarSeparator visible="{/isAuthenticated}" />

            <!-- Role Badge / User Identification -->
            <HBox alignItems="Center" visible="{/isAuthenticated}" class="shell-user-badge sapUiTinyMarginEnd">
                <core:Icon src="sap-icon://badge" size="14px" color="#0070f2" class="sapUiTinyMarginEnd" />
                <Text text="{/userPrimaryRoleTitle}" class="shell-role-text" />
            </HBox>

            <!-- Theme Toggle -->
            <!-- <Button
                icon="sap-icon://palette"
                tooltip="Toggle Morning Light / Evening Dark Theme"
                type="Transparent"
                press=".onToggleTheme" /> -->

            <!-- User Profile Avatar & Sign Out -->
            <f:Avatar
                id="shellAvatar"
                initials="{/userInitials}"
                backgroundColor="{/userAvatarColor}"
                displaySize="XS"
                tooltip="User Account &amp; RBAC Roles (Click to View)"
                visible="{/isAuthenticated}"
                press=".onProfilePressed"
                class="sapUiTinyMarginBegin sapUiTinyMarginEnd cursor-pointer" />

            <Button
                icon="sap-icon://log-out"
                tooltip="Sign Out from Current Session"
                type="Transparent"
                visible="{/isAuthenticated}"
                press=".onSignOutPress" />

            <!-- Sign In button when unauthenticated -->
            <Button
                text="Sign In"
                icon="sap-icon://account"
                type="Emphasized"
                tooltip="Sign In to Operational Workspace"
                visible="{= !${/isAuthenticated} }"
                press=".onSignInNav" />
        </tnt:ToolHeader>

        <!-- Navigation Container: pages registered here -->
        <NavContainer
            id="navContainer"
            autoFocus="false"
            class="app-nav-container">
            <layoutData>
                <FlexItemData growFactor="1" baseSize="0" />
            </layoutData>
            <pages>
                <mvc:XMLView id="loginPage" viewName="factory.gate.view.Login" />
                <mvc:XMLView id="landingPage" viewName="factory.gate.view.Landing" />
                <mvc:XMLView id="launchpadPage" viewName="factory.gate.view.Dashboard" />
                <mvc:XMLView id="feViewerPage" viewName="factory.gate.view.Viewer" />
                <mvc:XMLView id="mainGateOpsPage" viewName="factory.gate.view.Operations" />
                <mvc:XMLView id="securityGateOpsPage" viewName="factory.gate.view.SecurityOperations" />
                <mvc:XMLView id="weighbridgeOpsPage" viewName="factory.gate.view.WeighbridgeOperations" />
                <mvc:XMLView id="editGateEntryPage" viewName="factory.gate.view.EditGateEntry" />
                <mvc:XMLView id="editSecurityGateEntryPage" viewName="factory.gate.view.EditSecurityGateEntry" />
                <mvc:XMLView id="factoryGateOpsPage" viewName="factory.gate.view.FactoryOperations" />
                <mvc:XMLView id="userManagementPage" viewName="factory.gate.view.UserManagement" />
                <mvc:XMLView id="reportsPage" viewName="factory.gate.view.Reports" />
            </pages>
        </NavContainer>
    </VBox>
</mvc:View>
