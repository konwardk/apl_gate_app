<mvc:View
    controllerName="factory.gate.controller.FactoryOperations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" enableScrolling="true">
        <!-- Subtoolbar matching other operational stations -->
        <OverflowToolbar class="fe-subtoolbar">
            <Button
                text="Back to Launchpad"
                icon="sap-icon://nav-back"
                type="Emphasized"
                press=".onNavBack" />
            <ToolbarSpacer />
            <Title text="Factory Gate Operations (Unloading &amp; Yard Clearance)" level="H2" titleStyle="H3" />
            <ToolbarSpacer />
            <Button
                text="Main Gate Ops"
                icon="sap-icon://log-in"
                type="Transparent"
                visible="{/canViewMainGateOps}"
                press=".onNavMainGateOps" />
            <Button
                text="Security Gate Ops"
                icon="sap-icon://shield"
                type="Transparent"
                visible="{/canViewSecurityGateOps}"
                press=".onNavSecurityGateOps" />
            <Button
                text="Weighbridge Ops"
                icon="sap-icon://dimension"
                type="Transparent"
                visible="{/canViewWeighbridgeOps}"
                press=".onNavWeighbridgeOps" />
            <ToolbarSeparator />
            <Button
                text="Refresh Queue"
                icon="sap-icon://refresh"
                type="Transparent"
                press=".onRefreshQueue" />
        </OverflowToolbar>

        <VBox class="flp-dashboard">
            <!-- Context Banner -->
            <MessageStrip
                text="Factory Gate Station: Search or select a Gate IN Number to view consignment and Purchase Order (PO) details. Record Factory Gate IN time and operator name on arrival, and Factory Gate OUT time and remarks upon yard exit."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Factory Operations Entry Form Panel -->
            <Panel
                headerText="Record Factory Gate Operations"
                expandable="false"
                class="sapUiSmallMarginBottom flp-tile-ops">
                <content>
                    <form:SimpleForm
                        id="factoryEntryForm"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="1">
                        <form:content>
                            <!-- Column 1: Consignment & Purchase Order Details (Display/Reference) -->
                            <core:Title text="1. Consignment &amp; Purchase Order Details" />

                            <Label text="Gate IN Number" required="true" />
                            <HBox width="100%" alignItems="Center">
                                <ComboBox
                                    id="facGateInComboBox"
                                    width="100%"
                                    placeholder="Search or select Gate IN #, Vehicle Reg, or PO..."
                                    selectedKey="{facModel>/selectedGateInNumber}"
                                    change=".onGateInSelectChange"
                                    selectionChange=".onGateInSelectChange"
                                    showClearIcon="true"
                                    filterSecondaryValues="true"
                                    showSecondaryValues="true"
                                    items="{
                                        path: 'facModel>/eligibleVehicles',
                                        templateShareable: false
                                    }">
                                    <core:ListItem
                                        key="{facModel>gateInNumber}"
                                        text="{facModel>gateInNumber}"
                                        additionalText="{facModel>vehicleRegNo} ({facModel>status}) - {facModel>deliveryFlowDesc}" />
                                    <layoutData>
                                        <FlexItemData growFactor="1" />
                                    </layoutData>
                                </ComboBox>
                                <Button
                                    text="Search"
                                    icon="sap-icon://search"
                                    type="Emphasized"
                                    press=".onSearchGateInBtnPress"
                                    class="sapUiTinyMarginBegin" />
                            </HBox>

                            <Label text="Vehicle Reg No" />
                            <HBox alignItems="Center">
                                <Text
                                    text="{= ${facModel>/selectedVehicle/vehicleRegNo} || 'Search or select a Gate IN Number' }"
                                    class="sapUiTinyMarginEnd"
                                    design="Bold" />
                                <ObjectStatus
                                    text="{= ${facModel>/selectedVehicle/status} ? 'Stage: ' + ${facModel>/selectedVehicle/status} : '' }"
                                    state="{path: 'facModel>/selectedVehicle/status', formatter: '.formatter.getStatusState'}" />
                            </HBox>

                            <Label text="Process Status" visible="{= Boolean(${facModel>/vehicleStageMessage}) }" />
                            <MessageStrip
                                text="{facModel>/vehicleStageMessage}"
                                type="{facModel>/vehicleStageMessageType}"
                                visible="{= Boolean(${facModel>/vehicleStageMessage}) }"
                                showIcon="true" />

                            <Label text="Vehicle &amp; Driver" />
                            <HBox alignItems="Center">
                                <Text text="{= ${facModel>/selectedVehicle/vehicleType} || '-' }" class="sapUiTinyMarginEnd" />
                                <Text text="{= ${facModel>/selectedVehicle/driverName} ? '(' + ${facModel>/selectedVehicle/driverName} + ')' : '' }" />
                            </HBox>

                            <Label text="Transporter" />
                            <Text text="{= ${facModel>/selectedVehicle/transporter/transporterName} || ${facModel>/form/transporterName} || '-' }" />

                            <Label text="Delivery Flow" />
                            <HBox alignItems="Center">
                                <ObjectStatus
                                    text="{= ${facModel>/selectedVehicle/deliveryFlowDesc} || '-' }"
                                    state="{= ${facModel>/selectedVehicle/deliveryFlowState} || 'None' }"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="{= ${facModel>/selectedVehicle/inboundWeightFormatted} ? '(Gross: ' + ${facModel>/selectedVehicle/inboundWeightFormatted} + ')' : '' }" />
                            </HBox>

                            <Label text="PO Number" />
                            <HBox alignItems="Center">
                                <Text
                                    text="{= ${facModel>/form/poNumber} || 'No PO Assigned / Without PO' }"
                                    design="Bold"
                                    class="sapUiTinyMarginEnd" />
                                <ObjectStatus
                                    text="{= ${facModel>/selectedPoDetails/PurchaseOrderType} ? 'Type: ' + ${facModel>/selectedPoDetails/PurchaseOrderType} : '' }"
                                    state="Information"
                                    visible="{= Boolean(${facModel>/selectedPoDetails/PurchaseOrderType}) }" />
                            </HBox>

                            <Label text="PO Date" visible="{= Boolean(${facModel>/selectedPoDetails/PurchaseOrderDate}) }" />
                            <Text
                                text="{path: 'facModel>/selectedPoDetails/PurchaseOrderDate', formatter: '.formatter.formatDate'}"
                                visible="{= Boolean(${facModel>/selectedPoDetails/PurchaseOrderDate}) }" />

                            <Label text="Supplier / Vendor" />
                            <VBox>
                                <Text text="{= ${facModel>/form/supplierName} || ${facModel>/selectedVehicle/supplier/supplierName} || '-' }" design="Bold" />
                                <Text
                                    text="{= ${facModel>/selectedPoDetails/Supplier} ? 'Code: ' + ${facModel>/selectedPoDetails/Supplier} : (${facModel>/selectedVehicle/supplier/supplierCode} ? 'Code: ' + ${facModel>/selectedVehicle/supplier/supplierCode} : '') }"
                                    class="sapUiTinyMarginTop"
                                    visible="{= Boolean(${facModel>/selectedPoDetails/Supplier} || ${facModel>/selectedVehicle/supplier/supplierCode}) }" />
                            </VBox>

                            <Label text="Invoice Number" />
                            <Text text="{= ${facModel>/form/invoiceNumber} || '-' }" />

                            <Label text="Invoice Date" />
                            <Text text="{path: 'facModel>/form/invoiceDate', formatter: '.formatter.formatDate'}" />

                            <!-- Column 2: Factory Operations Inputs to Collect (IN, Operator, OUT, Remarks) -->
                            <core:Title text="2. Factory Gate Recording" />

                            <Label text="Factory Gate IN Time" required="true" />
                            <DateTimePicker
                                id="facInDateTimePicker"
                                value="{facModel>/form/factoryGateInDateTimeStr}"
                                valueFormat="yyyy-MM-dd'T'HH:mm:ss"
                                displayFormat="dd/MM/yyyy, HH:mm:ss"
                                change=".onGateInDateTimeChange"
                                placeholder="Select Factory Gate IN Date &amp; Time" />

                            <Label text="Factory Gate Operator" required="true" />
                            <Input
                                id="inputFacInOperator"
                                value="{facModel>/form/factoryGateInOperator}"
                                placeholder="Enter Factory Gate Operator name" />

                            <Label text="Factory Gate OUT Time" />
                            <DateTimePicker
                                id="facOutDateTimePicker"
                                value="{facModel>/form/factoryGateOutDateTimeStr}"
                                valueFormat="yyyy-MM-dd'T'HH:mm:ss"
                                displayFormat="dd/MM/yyyy, HH:mm:ss"
                                change=".onGateOutDateTimeChange"
                                placeholder="Select Factory Gate OUT Date &amp; Time (on Gate exit)" />

                            <Label text="Gate Out Type" />
                            <ComboBox
                                id="comboGateOutType"
                                selectedKey="{facModel>/form/gateOutType}"
                                placeholder="Select Gate Out Type (RGP, NRGP, etc.)"
                                width="100%">
                                <items>
                                    <core:Item key="STANDARD" text="Standard Clearance (Delivery Completed)" />
                                    <core:Item key="RGP" text="RGP - Returnable Gate Pass" />
                                    <core:Item key="NRGP" text="NRGP - Non-Returnable Gate Pass" />
                                    <core:Item key="MATERIAL_RETURN" text="Material Return / Rejection" />
                                    <core:Item key="EMPTY_VEHICLE" text="Empty Vehicle Exit" />
                                </items>
                            </ComboBox>

                            <Label text="Remarks" />
                            <TextArea
                                id="inputFacRemarks"
                                value="{facModel>/form/remarks}"
                                rows="4"
                                maxLength="500"
                                placeholder="Enter remarks on gate exit / unloading observations..." />
                        </form:content>
                    </form:SimpleForm>

                    <!-- Form Action Buttons -->
                    <OverflowToolbar class="sapUiTinyMarginTop">
                        <ToolbarSpacer />
                        <Button
                            id="btnRecordFactoryIn"
                            text="Record Factory Gate IN"
                            icon="sap-icon://log-in"
                            type="Emphasized"
                            press=".onRecordFactoryIn" />
                        <Button
                            id="btnRecordFactoryOut"
                            text="Record Factory Gate OUT"
                            icon="sap-icon://log-out"
                            type="Success"
                            press=".onRecordFactoryOut" />
                        <Button
                            id="btnRecordFullClearance"
                            text="Complete Clearance (IN &amp; OUT)"
                            icon="sap-icon://accept"
                            type="Default"
                            tooltip="Save full factory operation with both check-in and check-out at once"
                            press=".onRecordFullClearance" />
                        <Button
                            text="Reset Form"
                            icon="sap-icon://reset"
                            type="Transparent"
                            press=".onResetForm" />
                    </OverflowToolbar>
                </content>
            </Panel>

            <!-- Factory Yard Operational Queue Table -->
            <Table
                id="factoryTxTable"
                growing="true"
                growingThreshold="20"
                items="{facModel>/displayedRecords}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Factory Yard Delivery Records ({= ${facModel>/displayedRecords} ? ${facModel>/displayedRecords}.length : 0 })" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="facFilterSegmentedBtn"
                            selectedKey="{facModel>/selectedFilter}"
                            selectionChange=".onFilterCategoryChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All ({= ${facModel>/allCount} })" />
                                <SegmentedButtonItem key="WAITING_IN" text="Awaiting Factory IN ({= ${facModel>/waitingInCount} })" />
                                <SegmentedButtonItem key="INSIDE_YARD" text="Inside Yard ({= ${facModel>/insideYardCount} })" />
                                <SegmentedButtonItem key="YARD_DONE" text="Yard Completed ({= ${facModel>/yardDoneCount} })" />
                            </items>
                        </SegmentedButton>
                        <SearchField
                            id="facSearchField"
                            width="250px"
                            placeholder="Search Gate IN #, Vehicle, PO..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search &amp; Filters"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Queue"
                            press=".onRefreshQueue" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><header><Text text="Gate IN # / Vehicle" /></header></Column>
                    <Column><header><Text text="Driver / Transporter" /></header></Column>
                    <Column><header><Text text="Delivery Flow" /></header></Column>
                    <Column><header><Text text="PO &amp; Invoice #" /></header></Column>
                    <Column><header><Text text="Factory Gate IN" /></header></Column>
                    <Column><header><Text text="Factory Gate OUT" /></header></Column>
                    <Column><header><Text text="Status &amp; Remarks" /></header></Column>
                    <Column hAlign="End" width="220px"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <VBox>
                                <ObjectIdentifier title="{facModel>gateInNumber}" />
                                <Text text="{facModel>vehicleRegNo}" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <Text text="{= ${facModel>driverName} || '-' }" design="Bold" />
                                <Text text="{= ${facModel>transporter/transporterName} || ${facModel>factoryEntry/transporterName} || '-' }" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <ObjectStatus
                                    text="{facModel>deliveryFlowDesc}"
                                    state="{facModel>deliveryFlowState}" />
                                <Text
                                    text="{= ${facModel>inboundWeightFormatted} ? 'Gross: ' + ${facModel>inboundWeightFormatted} : 'Scale Bypassed' }"
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <Text text="{= 'PO: ' + (${facModel>factoryEntry/poNumber} || ${facModel>securityEntry/poNumber} || 'N/A') }" />
                                <Text text="{= 'Inv: ' + (${facModel>factoryEntry/invoiceNumber} || ${facModel>securityEntry/invoiceNumber} || 'N/A') }" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <Text text="{path: 'facModel>factoryEntry/factoryGateInDateTime', formatter: '.formatter.formatDateTime'}" />
                                <Text text="{= ${facModel>factoryEntry/factoryGateInOperator} ? 'By: ' + ${facModel>factoryEntry/factoryGateInOperator} : '-' }" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <Text text="{path: 'facModel>factoryEntry/factoryGateOutDateTime', formatter: '.formatter.formatDateTime'}" />
                                <Text text="{= ${facModel>factoryEntry/factoryGateOutOperator} ? 'By: ' + ${facModel>factoryEntry/factoryGateOutOperator} : '-' }" class="sapUiTinyMarginTop" />
                            </VBox>

                            <VBox>
                                <ObjectStatus
                                    text="{facModel>status}"
                                    state="{path: 'facModel>status', formatter: '.formatter.getStatusState'}" />
                                <Text
                                    text="{= ${facModel>factoryEntry/remarks} ? ${facModel>factoryEntry/remarks} : '-' }"
                                    maxLines="2"
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <HBox justifyContent="End" alignItems="Center">
                                <Button
                                    icon="sap-icon://edit"
                                    tooltip="Select and Load into Form"
                                    type="Transparent"
                                    press=".onRowSelectPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="IN"
                                    icon="sap-icon://log-in"
                                    type="Emphasized"
                                    tooltip="Perform Factory Gate IN"
                                    visible="{facModel>canRowFactoryIn}"
                                    press=".onRowFactoryInPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="OUT"
                                    icon="sap-icon://log-out"
                                    type="Success"
                                    tooltip="Perform Factory Gate OUT"
                                    visible="{facModel>canRowFactoryOut}"
                                    press=".onRowFactoryOutPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    icon="sap-icon://print"
                                    tooltip="Print Pass"
                                    type="Transparent"
                                    press=".onRowPrintPress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
