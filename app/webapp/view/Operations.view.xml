                    sizeBehavior="Responsive"
                    state="Disabled"
                    class="vehicle-select-tile sapUiMediumMargin">
                    <tileContent>
                        <TileContent footer="External S/4HANA System (In Development)">
                            <content>
                                <NumericContent
                                    icon="sap-icon://mileage"
                                    value="Tankers"
                                    valueColor="Neutral" />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile
                    header="OTHER VEHICLE"
                    subheader="Main Gate Processing Stream"
                    sizeBehavior="Responsive"
                    press=".onOtherVehicleStreamPress"
                    class="vehicle-select-tile sapUiMediumMargin">
                    <tileContent>
                        <TileContent footer="Trucks, Containers, Trailers, LCV (Active)">
                            <content>
                                <NumericContent
                                    icon="sap-icon://shipping-status"
                                    value="Active"
                                    valueColor="Good" />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </HBox> -->

            <!-- Active Transactions Table -->
            <Table
                id="quickTxTable"
                growing="true"
                growingThreshold="20"
                items="{/transactions}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Main Gate Scale &amp; Entry Records ({= ${/transactions} ? ${/transactions}.length : 0 })" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="opsFilterSegmentedBtn"
                            selectedKey="ALL"
                            selectionChange=".onFilterCategoryChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All ({= ${/counts/TOTAL} || 0 })" />
                                <SegmentedButtonItem key="GATE_IN" text="Main Gate IN ({= ${/counts/GATE_IN} || 0 })" />
                                <SegmentedButtonItem key="IN_PLANT" text="In Plant ({= ${/counts/IN_PLANT} || 0 })" />
                                <SegmentedButtonItem key="READY_OUT" text="Ready for Gate OUT ({= ${/counts/READY_OUT} || 0 })" />
                                <SegmentedButtonItem key="COMPLETED" text="Completed ({= ${/counts/COMPLETED} || 0 })" />
                            </items>
                        </SegmentedButton>
                        <SearchField
                            id="opsSearchField"
                            width="240px"
                            placeholder="Search Gate IN #, Vehicle, Driver..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search &amp; Filters"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Gate Entries Queue"
                            press=".onRefreshQueue" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><header><Text text="Gate IN # / Vehicle" /></header></Column>
                    <Column><header><Text text="Driver Name" /></header></Column>
                    <Column><header><Text text="Purpose" /></header></Column>
                    <Column><header><Text text="Status" /></header></Column>
                    <Column><header><Text text="Current Stage" /></header></Column>
                    <Column><header><Text text="Gate IN Time" /></header></Column>
                    <Column><header><Text text="Gate OUT Time" /></header></Column>
                    <Column hAlign="End" width="220px"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTxRowPress">
                        <cells>
                            <ObjectIdentifier
                                title="{gateInNumber}"
                                text="{vehicleRegNo}" />
                            <Text text="{= ${driverName} || '-' }" />
                            <ObjectStatus
                                text="{purpose}"
                                state="{path: 'purpose', formatter: '.formatter.getPurposeState'}" />
                            <ObjectStatus
                                text="{status}"
                                state="{path: 'status', formatter: '.formatter.getStatusState'}" />
                            <Text text="{currentStage}" />
                            <Text text="{path: 'gateInDateTime', formatter: '.formatter.formatDateTime'}" />
                            <Text text="{path: 'gateOutDateTime', formatter: '.formatter.formatDateTime'}" />
                            <HBox justifyContent="End" alignItems="Center" wrap="NoWrap" class="sapUiTinyMarginBeginEnd">
                                <!-- Gate OUT button: ONLY shown and clickable if all other operations are performed completely (status: SECURITY_OUT) -->
                                <Button
                                    text="Gate OUT"
                                    icon="sap-icon://log-out"
                                    type="Success"
                                    tooltip="Authorize and record final Main Gate OUT exit clearance"
                                    visible="{= ${status} === 'SECURITY_OUT' }"
                                    enabled="{= ${status} === 'SECURITY_OUT' }"
                                    press=".onRowGateOutPress"
                                    class="sapUiTinyMarginEnd" />

                                <!-- Gated OUT Status Badge -->
                                <ObjectStatus
                                    text="Gated OUT"
                                    state="Success"
                                    icon="sap-icon://sys-enter-2"
                                    visible="{= ${status} === 'COMPLETED' }"
                                    class="sapUiTinyMarginEnd" />

                                <Button
                                    icon="sap-icon://print"
                                    type="Transparent"
                                    tooltip="Print Gate IN Pass"
                                    press=".onTxPrintPress" />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit Gate Entry"
                                    press=".onTxEditPress" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete Gate Entry"
                                    visible="{= ${status} === 'GATE_IN' || ${status} === 'CANCELLED' }"
                                    press=".onTxDeletePress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
