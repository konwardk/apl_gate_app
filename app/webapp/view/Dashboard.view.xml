<mvc:View
    controllerName="factory.gate.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" enableScrolling="true">
        <VBox class="flp-dashboard">
            <!-- User Profile & Assigned Operational Workspace Hero Banner -->
            <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="dashboard-hero-card sapUiSmallMarginBottom">
                <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                    <f:Avatar
                        initials="{/userInitials}"
                        backgroundColor="{/userAvatarColor}"
                        displaySize="M"
                        class="sapUiSmallMarginEnd" />
                    <VBox>
                        <HBox alignItems="Center">
                            <Title text="Welcome, {/userName}" level="H2" titleStyle="H3" class="sapUiTinyMarginEnd" />
                            <ObjectStatus text="{/userPrimaryRoleTitle}" state="Information" inverted="true" />
                        </HBox>
                        <Text text="{= ${/userDepartment} ? ${/userDesignation} + ' • ' + ${/userDepartment} : ${/userDesignation} }" class="text-muted sapUiTinyMarginTop" />
                    </VBox>
                </HBox>
                <HBox alignItems="Center" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                    <Button
                        text="Open {/assignedScreenTitle}"
                        icon="{/assignedScreenIcon}"
                        type="Emphasized"
                        press=".onOpenAssignedWorkspace"
                        visible="{= !!${/assignedScreen} &amp;&amp; ${/assignedScreen} !== 'launchpadPage' }"
                        class="sapUiTinyMarginEnd" />
                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        tooltip="Refresh Live KPI Counts &amp; Transactions"
                        type="Transparent"
                        press=".onRefreshDashboard" />
                </HBox>
            </HBox>

            <!-- Stream Context Notification Banner -->
            <MessageStrip
                text="Vehicle Stream: OTHER VEHICLE (General Cargo, Trucks, Containers, LCV). Choose a Fiori application or operational tool below."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Live Operations Overview Section -->
            <VBox class="flp-section" visible="{/canViewLiveOps}">
                <Title
                    text="Live Operations Overview"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />

                <HBox wrap="NoWrap" class="flp-kpi-bar">
                    <GenericTile
                        header="Total Gate Entries"
                        subheader="All Vehicles"
                        press=".onKpiPress"
                        class="kpi-tile-card">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{/counts/TOTAL}"
                                        icon="sap-icon://shipping-status"
                                        valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Active In Plant"
                        subheader="Inside Factory Yard"
                        press=".onKpiPress"
                        class="kpi-tile-card">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{/counts/ACTIVE}"
                                        icon="sap-icon://factory"
                                        valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Ready for Gate OUT"
                        subheader="Cleared Security"
                        press=".onKpiPress"
                        class="kpi-tile-card">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{/counts/READY_OUT}"
                                        icon="sap-icon://log-out"
                                        valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Completed Exits"
                        subheader="Final Exit Authorized"
                        press=".onKpiPress"
                        class="kpi-tile-card">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{/counts/COMPLETED}"
                                        icon="sap-icon://accept"
                                        valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>

            <!-- Group 1: Gate Operations & Execution Section -->
            <VBox class="flp-section" visible="{/canViewGateOps}">
                <Title
                    text="Gate Operations &amp; Execution"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />
                <HBox class="flp-tiles-grid">
                    <!-- <GenericTile
                        header="Gate Entries &amp; Exits"
                        subheader="SAP Fiori Elements Floorplan"
                        sizeBehavior="Responsive"
                        press=".onOpenGateTxFE"
                        class="flp-tile flp-tile-fe">
                        <tileContent>
                            <TileContent footer="List Report &amp; Object Page">
                                <content>
                                    <NumericContent icon="sap-icon://shipping-status" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile> -->

                    <GenericTile
                        header="Main Gate Operations"
                        subheader="Vehicle Stream &amp; Processing"
                        sizeBehavior="Responsive"
                        visible="{/canViewMainGateOps}"
                        press=".onOpenMainGateOps"
                        class="flp-tile flp-tile-ops">
                        <tileContent>
                            <TileContent footer="Gate IN / OUT Clearance">
                                <content>
                                    <NumericContent icon="sap-icon://log-in" value="{/counts/TOTAL}" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Security Gate Operations"
                        subheader="Vehicle &amp; PO Document Clearance"
                        sizeBehavior="Responsive"
                        visible="{/canViewSecurityGateOps}"
                        press=".onOpenSecurityGateOps"
                        class="flp-tile flp-tile-ops">
                        <tileContent>
                            <TileContent footer="Physical Check &amp; Delivery Docs">
                                <content>
                                    <NumericContent icon="sap-icon://shield" value="{/counts/ACTIVE}" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Weighbridge Operations"
                        subheader="Gross &amp; Tare Weighment Clearance"
                        sizeBehavior="Responsive"
                        visible="{/canViewWeighbridgeOps}"
                        press=".onOpenWeighbridgeOps"
                        class="flp-tile flp-tile-ops">
                        <tileContent>
                            <TileContent footer="Digital Scale &amp; Net Weight">
                                <content>
                                    <NumericContent icon="sap-icon://dimension" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Factory Gate Operations"
                        subheader="Delivery Unloading &amp; Yard Clearance"
                        sizeBehavior="Responsive"
                        visible="{/canViewFactoryGateOps}"
                        press=".onOpenFactoryGateOps"
                        class="flp-tile flp-tile-ops">
                        <tileContent>
                            <TileContent footer="Plant Unloading &amp; Clearance">
                                <content>
                                    <NumericContent icon="sap-icon://factory" value="{/counts/IN_PLANT}" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>

            <!-- Group 2: Master Data Management (Hidden for Main Gate User) -->
            <VBox class="flp-section" visible="{/canViewMasterData}">
                <Title
                    text="Master Data Management (SAP Fiori Elements)"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />
                <HBox class="flp-tiles-grid">
                    <GenericTile
                        header="Vehicles Master"
                        subheader="Fleet &amp; Capacity Registry"
                        sizeBehavior="Responsive"
                        press=".onOpenVehiclesFE"
                        class="flp-tile flp-tile-master">
                        <tileContent>
                            <TileContent footer="Fiori Elements List Report">
                                <content>
                                    <NumericContent icon="sap-icon://car-rental" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Drivers Master"
                        subheader="License &amp; Driver Records"
                        sizeBehavior="Responsive"
                        press=".onOpenDriversFE"
                        class="flp-tile flp-tile-master">
                        <tileContent>
                            <TileContent footer="Fiori Elements List Report">
                                <content>
                                    <NumericContent icon="sap-icon://person-placeholder" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Transporters Master"
                        subheader="Carriers &amp; Logistics Partners"
                        sizeBehavior="Responsive"
                        press=".onOpenTransportersFE"
                        class="flp-tile flp-tile-master">
                        <tileContent>
                            <TileContent footer="Fiori Elements List Report">
                                <content>
                                    <NumericContent icon="sap-icon://supplier" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Suppliers Master"
                        subheader="Vendor &amp; SAP BP Master"
                        sizeBehavior="Responsive"
                        press=".onOpenSuppliersFE"
                        class="flp-tile flp-tile-master">
                        <tileContent>
                            <TileContent footer="Fiori Elements List Report">
                                <content>
                                    <NumericContent icon="sap-icon://factory" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>

            <!-- Group 3: Compliance & Audit (Visible for Auditor, Admin, Superadmin) -->
            <VBox class="flp-section" visible="{/canViewAuditTrail}">
                <Title
                    text="Governance &amp; Audit Trail (SAP Fiori Elements)"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />
                <HBox class="flp-tiles-grid">
                    <GenericTile
                        header="Gate Audit Trail"
                        subheader="Process &amp; Security History"
                        sizeBehavior="Responsive"
                        press=".onOpenAuditFE"
                        class="flp-tile flp-tile-audit">
                        <tileContent>
                            <TileContent footer="Fiori Elements List Report">
                                <content>
                                    <NumericContent icon="sap-icon://history" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>
            <!-- Group 4: Operational Reports & Analytics (Admin, Superadmin) -->
            <VBox class="flp-section" visible="{/canViewReports}">
                <Title
                    text="Operational Reports &amp; Analytics"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />
                <HBox class="flp-tiles-grid">
                    <GenericTile
                        header="Operational Gate Reports"
                        subheader="Main Gate, Security, Weighbridge &amp; Factory Yard"
                        sizeBehavior="Responsive"
                        press=".onOpenReports"
                        class="flp-tile flp-tile-reports">
                        <tileContent>
                            <TileContent footer="Filter, Inspect &amp; Export PDF / CSV">
                                <content>
                                    <NumericContent icon="sap-icon://pdf-attachment" valueColor="Good" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>

            <!-- Group 5: Superadmin Console (Only visible for Superadmin) -->
            <VBox class="flp-section" visible="{/canManageUsers}">
                <Title
                    text="Superadmin Console &amp; Administration"
                    level="H2"
                    titleStyle="H3"
                    class="flp-section-title" />
                <HBox class="flp-tiles-grid">
                    <GenericTile
                        header="User Management"
                        subheader="Users, Credentials &amp; Multiple Roles"
                        sizeBehavior="Responsive"
                        press=".onOpenUserManagement"
                        class="flp-tile flp-tile-superadmin">
                        <tileContent>
                            <TileContent footer="Accounts, Service Status &amp; RBAC">
                                <content>
                                    <NumericContent icon="sap-icon://user-settings" valueColor="Neutral" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </VBox>
        </VBox>
    </Page>
</mvc:View>
