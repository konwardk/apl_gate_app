                                <Text text="{= ${editModel>/vehicle/permitNo} ? (${editModel>/vehicle/permitNo} + ' (Expires: ' + ${editModel>/vehicle/permitExpiry} + ')') : '-' }" />
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter> -->

