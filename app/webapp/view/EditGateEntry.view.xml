            </IconTabBar>
        </VBox>

        <!-- Footer Actions Toolbar -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Save Changes"
                    icon="sap-icon://save"
                    type="Emphasized"
                    press=".onSave" />
                <Button
                    text="Reset"
                    icon="sap-icon://reset"
                    type="Default"
                    press=".onReset" />
                <Button
                    text="Cancel"
                    icon="sap-icon://cancel"
                    type="Transparent"
                    press=".onCancel" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
