<mvc:View
    controllerName="factory.gate.controller.EditGateEntry"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <f:DynamicPage
        id="idEditGateEntryPage"
        headerExpanded="true"
        showFooter="true"
        class="fiori-dynamic-page sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <Button
                        text="Main Gate"
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back to Main Gate Operations"
                        press=".onNavBack" />
                </f:navigationActions>
                <f:heading>
                    <HBox alignItems="Center" wrap="Wrap">
                        <Title
                            text="{= 'Gate Entry ' + (${editModel>/gateInNumber} || '') }"
                            level="H1"
                            titleStyle="H3"
                            class="sapUiSmallMarginEnd" />
                        <ObjectStatus
                            text="{path: 'editModel>/status', formatter: '.formatter.getStatusText'}"
                            state="{path: 'editModel>/status', formatter: '.formatter.getStatusState'}"
                            inverted="true" />
                    </HBox>
                </f:heading>
                <f:expandedContent>
                    <Text
                        text="{= 'Vehicle: ' + (${editModel>/vehicleRegNo} || '-') + ' • ' + (${path: 'editModel>/purpose', formatter: '.formatter.getPurposeText'} || '') }"
                        class="text-muted" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text
                        text="{= (${editModel>/vehicleRegNo} || '') + ' • Stage: ' + (${path: 'editModel>/currentStage', formatter: '.formatter.getStageText'} || '') }"
                        class="text-muted" />
                </f:snappedContent>
                <f:actions>
                    <Button
                        text="Main Gate Ops"
                        icon="sap-icon://log-in"
                        type="Transparent"
                        press=".onNavMainGateOps" />
                    <Button
                        text="Security Ops"
                        icon="sap-icon://shield"
                        type="Transparent"
                        visible="{/canViewSecurityGateOps}"
                        press=".onNavSecurityOps" />
                    <Button
                        text="Weighbridge Ops"
                        icon="sap-icon://dimension"
                        type="Transparent"
                        visible="{/canViewWeighbridgeOps}"
                        press=".onNavWeighbridgeOps" />
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="Reload Gate Entry"
                        type="Transparent"
                        press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <VBox>
                    <MessageStrip
                        visible="{= ${editModel>/status} === 'COMPLETED' || ${editModel>/status} === 'CANCELLED' }"
                        text="{= 'Notice: This transaction is in ' + ${editModel>/status} + ' status. Modifications require Admin or Superadmin privileges.' }"
                        type="Warning"
                        showIcon="true"
                        class="sapUiSmallMarginBottom" />

                    <!-- SAP Object Page Header Facets -->
                    <HBox wrap="Wrap" class="fiori-object-facets">
                        <VBox class="fiori-facet-block">
                            <Label text="Gate IN Number" class="fiori-facet-label" />
                            <ObjectIdentifier title="{editModel>/gateInNumber}" text="{editModel>/vehicleRegNo}" />
                        </VBox>
                        <VBox class="fiori-facet-block">
                            <Label text="Visit Purpose" class="fiori-facet-label" />
                            <ObjectStatus
                                text="{path: 'editModel>/purpose', formatter: '.formatter.getPurposeText'}"
                                state="{path: 'editModel>/purpose', formatter: '.formatter.getPurposeState'}"
                                inverted="true" />
                        </VBox>
                        <VBox class="fiori-facet-block">
                            <Label text="Current Stage" class="fiori-facet-label" />
                            <Text text="{path: 'editModel>/currentStage', formatter: '.formatter.getStageText'}" class="fiori-text-strong" />
                        </VBox>
                        <VBox class="fiori-facet-block">
                            <Label text="Gate IN" class="fiori-facet-label" />
                            <Text text="{path: 'editModel>/gateInDateTime', formatter: '.formatter.formatDateTime'}" />
                            <Text text="{= 'Op: ' + (${editModel>/gateInOperator} || '-') }" class="text-muted sapUiTinyMarginTop" />
                        </VBox>
                        <VBox class="fiori-facet-block">
                            <Label text="Gate OUT" class="fiori-facet-label" />
                            <Text text="{path: 'editModel>/gateOutDateTime', formatter: '.formatter.formatDateTime'}" />
                            <Text text="{= 'Op: ' + (${editModel>/gateOutOperator} || '-') }" class="text-muted sapUiTinyMarginTop" />
                        </VBox>
                    </HBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox class="fiori-page-container">
                <VBox class="fiori-surface-card">
                    <IconTabBar
                        id="editTabBar"
                        selectedKey="generalTab"
                        expandable="false"
                        backgroundDesign="Transparent">
                        <items>
                            <IconTabFilter
                                key="generalTab"
                                text="Vehicle &amp; Gate Pass"
                                icon="sap-icon://shipping-status">
                                <form:SimpleForm
                                    editable="true"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="3"
                                    labelSpanL="3"
                                    labelSpanM="4"
                                    labelSpanS="12"
                                    adjustLabelSpan="false"
                                    emptySpanXL="1"
                                    emptySpanL="1"
                                    emptySpanM="0"
                                    emptySpanS="0"
                                    columnsXL="2"
                                    columnsL="2"
                                    columnsM="1">
                                    <form:content>
                                        <core:Title text="Vehicle &amp; Driver Details" />

                                        <Label text="Gate IN Number" />
                                        <Input
                                            value="{editModel>/gateInNumber}"
                                            editable="false"
                                            class="grayed-out-input"
                                            description="(Immutable identifier)" />

                                        <Label text="Vehicle Reg No" required="true" />
                                        <Input
                                            id="inputEditVehicleReg"
                                            value="{editModel>/vehicleRegNo}"
                                            placeholder="e.g. MH-04-JK-1234 or AS-02-1234"
                                            liveChange=".onVehicleRegLiveChange"
                                            change=".onVehicleRegChange"
                                            valueState="{editModel>/vehicleRegNoState}"
                                            valueStateText="{editModel>/vehicleRegNoStateText}" />

                                        <Label text="Vehicle Type" required="true" />
                                        <Select
                                            selectedKey="{editModel>/vehicleType}"
                                            width="100%">
                                            <core:Item key="TRUCK" text="TRUCK - Standard Truck / Lorry" />
                                            <core:Item key="TANKER" text="TANKER - Liquid Cargo Tanker" />
                                            <core:Item key="TRAILER" text="TRAILER - Multi-axle Heavy Trailer" />
                                            <core:Item key="CONTAINER" text="CONTAINER - ISO Freight Container" />
                                            <core:Item key="LCV" text="LCV - Light Commercial Vehicle" />
                                            <core:Item key="OTHER" text="OTHER - Miscellaneous / Special Vehicle" />
                                        </Select>

                                        <Label text="Driver Name" required="true" />
                                        <Input
                                            value="{editModel>/driverName}"
                                            placeholder="Enter full driver name" />

                                        <Label text="Visit Purpose" required="true" />
                                        <Select
                                            selectedKey="{editModel>/purpose}"
                                            width="100%">
                                            <core:Item key="DELIVERY" text="DELIVERY - Inbound Material Consignment" />
                                            <core:Item key="PICKUP" text="PICKUP - Outbound Material Dispatch" />
                                        </Select>

                                        <core:Title text="Status, Stages &amp; Timestamps" />

                                        <Label text="Transaction Status" required="true" />
                                        <Select
                                            id="selectEditStatus"
                                            selectedKey="{editModel>/status}"
                                            change=".onStatusChange"
                                            width="100%">
                                            <core:Item key="GATE_IN" text="IN - Main Gate Check-In" />
                                            <core:Item key="SECURITY_IN" text="Security IN - Inbound Check Cleared" />
                                            <core:Item key="WEIGHBRIDGE_IN" text="Scale IN - Gross Scale Weighed" />
                                            <core:Item key="FACTORY_IN" text="Yard IN - Inside Plant Yard / Unloading" />
                                            <core:Item key="FACTORY_OUT" text="Yard OUT - Yard Unloading Cleared" />
                                            <core:Item key="WEIGHBRIDGE_OUT" text="Scale OUT - Tare Scale Weighed" />
                                            <core:Item key="SECURITY_OUT" text="Ready Exit - Outbound Cleared" />
                                            <core:Item key="COMPLETED" text="Exit - Main Gate Exit Completed" />
                                            <core:Item key="HOLD" text="On Hold - Transaction Held" />
                                            <core:Item key="CANCELLED" text="Cancelled - Entry Voided" />
                                        </Select>

                                        <Label text="Current Stage" required="true" />
                                        <Select
                                            selectedKey="{editModel>/currentStage}"
                                            width="100%">
                                            <core:Item key="MAIN_GATE_IN" text="Main Gate (MAIN_GATE_IN)" />
                                            <core:Item key="SECURITY_GATE_IN" text="Security Check (SECURITY_GATE_IN)" />
                                            <core:Item key="WEIGHBRIDGE_IN" text="Gross Scale (WEIGHBRIDGE_IN)" />
                                            <core:Item key="FACTORY" text="Factory Yard (FACTORY)" />
                                            <core:Item key="WEIGHBRIDGE_OUT" text="Tare Scale (WEIGHBRIDGE_OUT)" />
                                            <core:Item key="SECURITY_GATE_OUT" text="Exit Check (SECURITY_GATE_OUT)" />
                                            <core:Item key="MAIN_GATE_OUT" text="Main Gate Exit (MAIN_GATE_OUT)" />
                                            <core:Item key="COMPLETED" text="Exit Completed (COMPLETED)" />
                                        </Select>

                                        <Label text="Gate IN Operator" required="true" />
                                        <Input
                                            id="inputEditGateInOperator"
                                            value="{editModel>/gateInOperator}"
                                            placeholder="Operator who recorded Gate IN" />

                                        <Label text="Gate IN Date &amp; Time" required="true" />
                                        <DateTimePicker
                                            id="inputEditGateInDateTime"
                                            value="{path: 'editModel>/gateInDateTime', formatter: '.formatter.formatDateTime'}"
                                            change=".onGateInDateTimeChange"
                                            placeholder="Select or verify Gate IN Timestamp" />

                                        <Label text="Gate OUT Operator" />
                                        <Input
                                            id="inputEditGateOutOperator"
                                            value="{editModel>/gateOutOperator}"
                                            valueLiveUpdate="true"
                                            placeholder="Operator who recorded Gate OUT" />

                                        <Label text="Gate OUT Date &amp; Time" />
                                        <DateTimePicker
                                            id="inputEditGateOutDateTime"
                                            value="{path: 'editModel>/gateOutDateTime', formatter: '.formatter.formatDateTime'}"
                                            change=".onGateOutDateTimeChange"
                                            placeholder="Gate OUT Timestamp (if exited)" />

                                        <Label text="Operational Remarks" />
                                        <TextArea
                                            value="{editModel>/remarks}"
                                            rows="3"
                                            maxLength="500"
                                            placeholder="Operational notes, special instructions, or reason for modifications..." />
                                    </form:content>
                                </form:SimpleForm>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </VBox>
            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Save Changes"
                    icon="sap-icon://save"
                    type="Emphasized"
                    press=".onSave" />
                <Button
                    text="Reset"
                    icon="sap-icon://reset"
                    type="Default"
                    press=".onReset" />
                <Button
                    text="Cancel"
                    icon="sap-icon://cancel"
                    type="Transparent"
                    press=".onCancel" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
