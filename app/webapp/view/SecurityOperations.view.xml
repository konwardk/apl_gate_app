<mvc:View
    controllerName="factory.gate.controller.SecurityOperations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" enableScrolling="true">
        <!-- Subtoolbar -->
        <OverflowToolbar class="fe-subtoolbar">
            <Button
                text="Back to Launchpad"
                icon="sap-icon://nav-back"
                type="Emphasized"
                press=".onNavBack" />
            <ToolbarSpacer />
            <Title text="Security Gate Operations (Inspection &amp; Clearance)" level="H2" titleStyle="H3" />
            <ToolbarSpacer />
            <Button
                text="Main Gate"
                icon="sap-icon://log-in"
                type="Default"
                visible="{/canViewMainGateOps}"
                press=".onNavMainGateOps" />
            <Button
                text="Weighbridge"
                icon="sap-icon://dimension"
                type="Default"
                visible="{/canViewWeighbridgeOps}"
                press=".onNavWeighbridgeOps" />
            <Button
                text="Factory Gate"
                icon="sap-icon://factory"
                type="Default"
                visible="{/canViewFactoryGateOps}"
                press=".onNavFactoryGateOps" />
            <Button
                id="btnTopSecGateIn"
                text="Security Gate IN"
                icon="sap-icon://shield"
                type="Emphasized"
                tooltip="Perform Inbound Security Check &amp; PO/Invoice Verification"
                press=".onOpenSecurityGateInDialog" />
            <Button
                id="btnTopSecGateOut"
                text="Security Gate OUT"
                icon="sap-icon://log-out"
                type="Success"
                tooltip="Perform Outbound Security Check &amp; Exit Pass Clearance"
                press=".onOpenSecurityGateOutDialog" />
        </OverflowToolbar>

        <!-- Main Content -->
        <VBox class="flp-dashboard">
            <!-- Context Banner -->
            <MessageStrip
                text="Security Gate Station: Vehicle physical inspection, driver verification, consignment PO/invoice clearance (Security Gate IN), and exit gate pass authorization (Security Gate OUT). All activities are recorded on a single unified security record."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Security Operations Table -->
            <Table
                id="secTxTable"
                growing="true"
                growingThreshold="20"
                items="{secModel>/displayedRecords}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Security Gate Records ({= ${secModel>/displayedRecords}.length })" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="secFilterSegmentedBtn"
                            selectedKey="{secModel>/selectedFilter}"
                            selectionChange=".onFilterCategoryChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All ({= ${secModel>/allRecordsCount} })" />
                                <SegmentedButtonItem key="WAITING_IN" text="Awaiting Gate IN ({= ${secModel>/waitingInCount} })" />
                                <SegmentedButtonItem key="IN_PLANT" text="Inside Plant ({= ${secModel>/inPlantCount} })" />
                                <SegmentedButtonItem key="WAITING_OUT" text="Awaiting Gate OUT ({= ${secModel>/waitingOutCount} })" />
                                <SegmentedButtonItem key="CLEARED" text="Cleared ({= ${secModel>/clearedCount} })" />
                            </items>
                        </SegmentedButton>
                        <SearchField
                            id="secSearchField"
                            width="260px"
                            placeholder="Search Gate IN #, Vehicle, Driver..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search &amp; Filters"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Security Queue"
                            press=".onRefreshQueue" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><header><Text text="Gate IN # / Vehicle" /></header></Column>
                    <Column><header><Text text="Driver / License" /></header></Column>
                    <Column><header><Text text="Purpose" /></header></Column>
                    <Column><header><Text text="Security Gate IN" /></header></Column>
                    <Column><header><Text text="Security Gate OUT" /></header></Column>
                    <Column><header><Text text="Docs / Gate Pass" /></header></Column>
                    <Column><header><Text text="Stage / Status" /></header></Column>
                    <Column hAlign="End" width="420px"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTxRowPress">
                        <cells>
                            <!-- 1. Gate IN # & Vehicle Reg -->
                            <ObjectIdentifier
                                title="{secModel>gateInNumber}"
                                text="{secModel>vehicleRegNo}" />

                            <!-- 2. Driver Name & License -->
                            <VBox>
                                <Label text="{= ${secModel>driverName} || ${secModel>driver/driverName} || '-' }" design="Bold" />
                                <Text
                                    text="{= 'DL: ' + (${secModel>securityEntry/driverLicenseNo} || ${secModel>driver/drivingLicenseNo} || 'Pending') }"
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <!-- 3. Purpose -->
                            <ObjectStatus
                                text="{secModel>purpose}"
                                state="{path: 'secModel>purpose', formatter: '.formatter.getPurposeState'}" />

                            <!-- 4. Security Gate IN -->
                            <VBox>
                                <Text
                                    visible="{= !!${secModel>securityEntry/securityInDateTime} }"
                                    text="{path: 'secModel>securityEntry/securityInDateTime', formatter: '.formatter.formatDateTime'}" />
                                <ObjectStatus
                                    visible="{= !!${secModel>securityEntry/securityInDateTime} }"
                                    text="{= 'Officer: ' + (${secModel>securityEntry/securityPersonnel} || '-') }"
                                    state="Success"
                                    class="sapUiTinyMarginTop" />
                                <ObjectStatus
                                    visible="{= !${secModel>securityEntry/securityInDateTime} }"
                                    text="Pending Gate IN"
                                    state="Warning" />
                            </VBox>

                            <!-- 5. Security Gate OUT -->
                            <VBox>
                                <Text
                                    visible="{= !!${secModel>securityEntry/securityOutDateTime} }"
                                    text="{path: 'secModel>securityEntry/securityOutDateTime', formatter: '.formatter.formatDateTime'}" />
                                <ObjectStatus
                                    visible="{= !!${secModel>securityEntry/securityOutDateTime} }"
                                    text="{= 'Officer: ' + (${secModel>securityEntry/securityOutPersonnel} || '-') }"
                                    state="Success"
                                    class="sapUiTinyMarginTop" />
                                <ObjectStatus
                                    visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; (${secModel>status} === 'WEIGHBRIDGE_OUT' || ${secModel>status} === 'FACTORY_OUT') }"
                                    text="Awaiting Gate OUT"
                                    state="Warning" />
                                <ObjectStatus
                                    visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; ${secModel>status} === 'SECURITY_IN' }"
                                    text="Direct Exit / Factory Ready"
                                    state="Information" />
                                <ObjectStatus
                                    visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; (${secModel>status} === 'WEIGHBRIDGE_IN' || ${secModel>status} === 'FACTORY_IN') }"
                                    text="Inside Plant"
                                    state="Information" />
                                <Text
                                    visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; ${secModel>status} === 'GATE_IN' }"
                                    text="-" />
                            </VBox>

                            <!-- 6. Docs / Gate Pass -->
                            <VBox>
                                <Text
                                    text="{= ${secModel>securityEntry/poNumber} ? ('PO: ' + ${secModel>securityEntry/poNumber}) : (${secModel>securityEntry/rgpDocumentNo} ? ('RGP: ' + ${secModel>securityEntry/rgpDocumentNo}) : (${secModel>securityEntry/exitGatePassDocumentNo} ? ('Exit Pass: ' + ${secModel>securityEntry/exitGatePassDocumentNo}) : (${secModel>securityEntry/withoutPO} ? 'Without PO' : '-'))) }" />
                                <Text
                                    text="{= ${secModel>securityEntry/invoiceNumber} ? ('Inv: ' + ${secModel>securityEntry/invoiceNumber}) : '' }"
                                    visible="{= !!${secModel>securityEntry/invoiceNumber} }"
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <!-- 7. Current Stage & Status -->
                            <VBox>
                                <ObjectStatus
                                    text="{secModel>status}"
                                    state="{path: 'secModel>status', formatter: '.formatter.getStatusState'}" />
                                <Text
                                    text="{secModel>currentStage}"
                                    class="sapUiTinyMarginTop" />
                                <ObjectStatus
                                    visible="{= !!${secModel>assignedRoute} }"
                                    text="{= ${secModel>assignedRoute} === 'WEIGHBRIDGE' ? 'Route: Weighbridge' : (${secModel>assignedRoute} === 'FACTORY' ? 'Route: Factory Gate' : ${secModel>assignedRoute}) }"
                                    state="{= ${secModel>assignedRoute} === 'WEIGHBRIDGE' ? 'Information' : 'Success' }"
                                    class="sapUiTinyMarginTop" />
                            </VBox>

                            <!-- 8. Actions -->
                            <HBox justifyContent="End"
                                    alignItems="Center"
                                    wrap="NoWrap"
                                    class="sapUiNoMargin">
                                <Button
                                    text="Gate IN"
                                    icon="sap-icon://shield"
                                    type="Emphasized"
                                    tooltip="Process Security Gate IN"
                                    visible="{= ${secModel>status} === 'GATE_IN' &amp;&amp; !${secModel>securityEntry/securityInDateTime} }"
                                    press=".onRowGateInPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="To Weighbridge"
                                    icon="sap-icon://dimension"
                                    type="Default"
                                    tooltip="Assign Route: Send vehicle to Weighbridge for gross/tare weighment"
                                    visible="{= ${secModel>status} === 'SECURITY_IN' }"
                                    press=".onRowSendToWeighbridgePress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="To Factory"
                                    icon="sap-icon://factory"
                                    type="Emphasized"
                                    tooltip="Assign Route: Send vehicle directly to Factory Gate (Bypass Weighbridge)"
                                    visible="{= ${secModel>status} === 'SECURITY_IN' }"
                                    press=".onRowSendToFactoryPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="Release Factory"
                                    icon="sap-icon://log-out"
                                    type="Attention"
                                    tooltip="Complete Factory Operations and Release Vehicle"
                                    visible="{= ${secModel>status} === 'FACTORY_IN' }"
                                    press=".onRowReleaseFromFactoryPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="Gate OUT"
                                    icon="sap-icon://log-out"
                                    type="Success"
                                    tooltip="Process Security Gate OUT"
                                    visible="{= (${secModel>status} === 'WEIGHBRIDGE_OUT' || ${secModel>status} === 'FACTORY_OUT') &amp;&amp; !${secModel>securityEntry/securityOutDateTime} }"
                                    press=".onRowGateOutPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    icon="sap-icon://print"
                                    type="Transparent"
                                    tooltip="Print Gate IN Pass"
                                    press=".onRowPrintPress" />
                                <Button
                                    icon="sap-icon://detail-view"
                                    type="Transparent"
                                    tooltip="View Details"
                                    press=".onRowDetailPress" />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit Gate Entry"
                                    press=".onRowEditPress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
