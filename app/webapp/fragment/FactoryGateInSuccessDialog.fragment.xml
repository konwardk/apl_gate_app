<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog
        id="factoryGateInSuccessDialog"
        title="Factory Gate IN Completed"
        type="Message"
        state="Success"
        contentWidth="520px">
        <content>
            <VBox alignItems="Center" class="sapUiSmallMargin">
                <core:Icon
                    src="sap-icon://sys-enter-2"
                    color="#107e3e"
                    size="2.8rem"
                    class="sapUiSmallMarginBottom" />
                <Title
                    text="{facModel>/gateInSuccess/gateInNumber}"
                    level="H1"
                    titleStyle="H1"
                    class="sapUiTinyMarginBottom success-gate-number" />
                <ObjectStatus
                    text="Status: FACTORY_IN (Inside Plant Yard)"
                    state="Success"
                    class="sapUiSmallMarginBottom" />

                <form:SimpleForm
                    layout="ResponsiveGridLayout"
                    labelSpanXL="5"
                    labelSpanL="5"
                    labelSpanM="5"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="0"
                    emptySpanL="0"
                    columnsXL="1"
                    columnsL="1"
                    width="100%">
                    <form:content>
                        <Label text="Vehicle Reg No" />
                        <Text text="{facModel>/gateInSuccess/vehicleRegNo} ({facModel>/gateInSuccess/vehicleType})" design="Bold" />

                        <Label text="Driver / Transporter" />
                        <Text text="{facModel>/gateInSuccess/driverName} / {facModel>/gateInSuccess/transporterName}" />

                        <Label text="PO Number" />
                        <Text text="{facModel>/gateInSuccess/poNumber}" design="Bold" />

                        <Label text="Supplier" />
                        <Text text="{facModel>/gateInSuccess/supplierName}" />

                        <Label text="Factory Gate IN Time" />
                        <Text text="{path: 'facModel>/gateInSuccess/factoryGateInDateTime', formatter: '.formatter.formatDateTime'}" />

                        <Label text="Inbound Operator" />
                        <Text text="{facModel>/gateInSuccess/factoryGateInOperator}" />
                    </form:content>
                </form:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Print Gate IN Slip"
                icon="sap-icon://print"
                type="Emphasized"
                press=".onPrintFactoryGateInSlip" />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseFactoryGateInSuccessDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
