<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog
        id="detailDialog"
        title="Gate Transaction Details: {detailModel>/gateInNumber}"
        contentWidth="620px">
        <content>
            <VBox alignItems="Center" class="sapUiSmallMarginTop sapUiTinyMarginBottom">
                <Image
                    src="/images/APL_Logo.jpg"
                    height="38px"
                    class="sapUiTinyMarginBottom" />
                <Title
                    text="Assam Petro-Chemicals Ltd"
                    level="H4"
                    titleStyle="H5" />
                <Text
                    text="Address: Namprup, Dist: Dibrugarh(ASSAM), PO: Parbatpur-786623."
                    class="sapUiTinyMarginBottom text-muted" />
            </VBox>
            <form:SimpleForm
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12">
                <form:content>
                    <Label text="Gate IN Number" />
                    <Text text="{detailModel>/gateInNumber}" />

                    <Label text="Vehicle Reg No" />
                    <Text text="{detailModel>/vehicleRegNo}" />

                    <Label text="Driver Name" />
                    <Text text="{= ${detailModel>/driverName} || '-' }" />

                    <Label text="Visit Purpose" />
                    <ObjectStatus
                        text="{detailModel>/purpose}"
                        state="{path: 'detailModel>/purpose', formatter: '.formatter.getPurposeState'}" />

                    <Label text="Current Status" />
                    <ObjectStatus
                        text="{detailModel>/status}"
                        state="{path: 'detailModel>/status', formatter: '.formatter.getStatusState'}" />

                    <Label text="Current Stage" />
                    <Text text="{detailModel>/currentStage}" />

                    <Label text="Gate IN Time" />
                    <Text text="{path: 'detailModel>/gateInDateTime', formatter: '.formatter.formatDateTime'}" />

                    <Label text="Gate OUT Time" />
                    <Text text="{path: 'detailModel>/gateOutDateTime', formatter: '.formatter.formatDateTime'}" />

                    <Label text="Gate IN Operator" />
                    <Text text="{= ${detailModel>/gateInOperator} || '-' }" />
                </form:content>
            </form:SimpleForm>
        </content>
        <buttons>
            <Button
                text="Print Pass"
                icon="sap-icon://print"
                type="Default"
                tooltip="Print Official Gate Entry Pass"
                press=".onDetailPrint" />
            <Button
                text="Edit"
                icon="sap-icon://edit"
                type="Emphasized"
                press=".onDetailEdit" />
            <Button
                text="Close"
                press=".onDetailClose" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
