<mvc:View
    controllerName="factory.gate.controller.Operations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page showHeader="false" enableScrolling="true">
        <!-- Subtoolbar -->
        <OverflowToolbar class="fe-subtoolbar">
            <Button
                text="Back to Launchpad"
                icon="sap-icon://nav-back"
                type="Emphasized"
                press=".onNavBack" />
            <ToolbarSpacer />
            <Title text="Main Gate Operations &amp; Vehicle Check-In" level="H2" titleStyle="H3" />
            <ToolbarSpacer />
            <Button
                text="Security Gate"
                icon="sap-icon://shield"
                type="Default"
                press=".onNavSecurityGateOps" />
            <Button
                text="Weighbridge"
                icon="sap-icon://dimension"
                type="Default"
                press=".onNavWeighbridgeOps" />
            <Button
                text="Gate IN"
                icon="sap-icon://log-in"
                type="Emphasized"
                visible="{/canCreateGateIn}"
                press=".onOpenGateIn" />
            <Button
                text="Gate OUT"
                icon="sap-icon://log-out"
                type="Success"
                visible="{/canMainGateOut}"
                press=".onOpenGateOut" />
        </OverflowToolbar>

        <!-- Main Content -->
        <VBox class="flp-dashboard">
            <MessageStrip
                text="Select vehicle processing category. General cargo and trucks proceed with Main Gate Entry and Exit operations."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Stream selection tiles -->
            <!-- <HBox justifyContent="Center" class="vehicle-selection-cards">
                <GenericTile
                    header="TANKER"
