                    state="Disabled"
                    class="vehicle-select-tile sapUiMediumMargin">
                    <tileContent>
                        <TileContent footer="External S/4HANA System (In Development)">
                            <content>
                                <NumericContent
                                    icon="sap-icon://mileage"
                                    value="Tankers"
                                    valueColor="Neutral" />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile
                    header="OTHER VEHICLE"
                    subheader="Main Gate Processing Stream"
                    sizeBehavior="Responsive"
                    press=".onOtherVehicleStreamPress"
                    class="vehicle-select-tile sapUiMediumMargin">
                    <tileContent>
                        <TileContent footer="Trucks, Containers, Trailers, LCV (Active)">
                            <content>
                                <NumericContent
                                    icon="sap-icon://shipping-status"
                                    value="Active"
                                    valueColor="Good" />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </HBox> -->

            <!-- Active Transactions Table -->
            <Table
                id="quickTxTable"
                growing="true"
                growingThreshold="20"
                items="{/transactions}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Active Gate Transactions ({= ${/transactions}.length })" />
                        <ToolbarSpacer />
                        <SearchField
                            id="opsSearchField"
                            width="280px"
                            placeholder="Search by Gate IN #, Vehicle, Driver..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            text="Fiori Elements App"
                            icon="sap-icon://table-view"
                            type="Ghost"
                            tooltip="Open standard Fiori Elements List Report &amp; Object Page with full CRUD"
                            press=".onOpenFioriElementsApp" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><header><Text text="Gate IN # / Vehicle" /></header></Column>
                    <Column><header><Text text="Driver Name" /></header></Column>
                    <Column><header><Text text="Purpose" /></header></Column>
                    <Column><header><Text text="Status" /></header></Column>
                    <Column><header><Text text="Current Stage" /></header></Column>
                    <Column><header><Text text="Gate IN Time" /></header></Column>
                    <Column><header><Text text="Gate OUT Time" /></header></Column>
                    <Column hAlign="End"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTxRowPress">
                        <cells>
                            <ObjectIdentifier
                                title="{gateInNumber}"
                                text="{vehicleRegNo}" />
                            <Text text="{= ${driverName} || '-' }" />
                            <ObjectStatus
                                text="{purpose}"
                                state="{path: 'purpose', formatter: '.formatter.getPurposeState'}" />
                            <ObjectStatus
                                text="{status}"
                                state="{path: 'status', formatter: '.formatter.getStatusState'}" />
                            <Text text="{currentStage}" />
                            <Text text="{path: 'gateInDateTime', formatter: '.formatter.formatDateTime'}" />
                            <Text text="{path: 'gateOutDateTime', formatter: '.formatter.formatDateTime'}" />
                            <HBox justifyContent="End" class="sapUiTinyMarginBeginEnd">
                                <!-- <Button
                                    text="Details"
                                    icon="sap-icon://detail-view"
                                    type="Transparent"
                                    press=".onTxDetailPress" /> -->
                                <Button
                                    text="Edit"
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit Gate Entry"
                                    press=".onTxEditPress" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete Gate Entry"
                                    visible="{= ${status} === 'GATE_IN' || ${status} === 'CANCELLED' }"
                                    press=".onTxDeletePress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
