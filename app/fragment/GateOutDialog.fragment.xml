<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog
        id="gateOutDialog"
        title="Main Gate Exit - Authorize Gate OUT"
        contentWidth="460px">
        <content>
            <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Select Vehicle Pass" required="true" />
                    <Select
                        id="selectGateInPass"
                        width="100%"
                        items="{gateOutModel>/eligibleVehicles}">
                        <core:Item
                            key="{gateOutModel>gateInNumber}"
                            text="{gateOutModel>gateInNumber} ({gateOutModel>vehicleRegNo} - {gateOutModel>status})" />
                    </Select>
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Authorize Gate OUT"
                type="Success"
                press=".onGateOutConfirm" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onGateOutCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
