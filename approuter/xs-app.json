{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/gate/(.*)$",
      "target": "/gate/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/po/(.*)$",
      "target": "/po/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/gate-entry/webapp/(.*)$",
      "target": "/gate-entry/webapp/$1",
      "localDir": "resources",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/webapp/(.*)$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "none",
      "csrfProtection": false
    }
  ]
}
