{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/gate/(.*)$",
      "target": "/gate/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/po/(.*)$",
      "target": "/po/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/user-api/currentUser$",
      "target": "$1",
      "service": "user-container",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/gate-entry/webapp/(.*)$",
      "target": "/gate-entry/webapp/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/webapp/(.*)$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}
