<mvc:View
    controllerName="factory.gate.controller.Operations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage
        headerExpanded="true"
        showFooter="false"
        class="fiori-dynamic-page sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <Button
                        text="Launchpad"
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back to Launchpad"
                        press=".onNavBack" />
                </f:navigationActions>
                <f:heading>
                    <Title text="Main Gate Operations" level="H1" titleStyle="H3" />
                </f:heading>
                <f:expandedContent>
                    <Text text="Vehicle Check-In, Plant Progression &amp; Final Exit Clearance" class="text-muted" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="Vehicle Check-In &amp; Exit Clearance ({= ${/counts/TOTAL} || 0 } total)" class="text-muted" />
                </f:snappedContent>
                <f:actions>
                    <Button
                        text="Security Gate"
                        icon="sap-icon://shield"
                        type="Transparent"
                        visible="{/canViewSecurityGateOps}"
                        press=".onNavSecurityGateOps" />
                    <Button
                        text="Weighbridge"
                        icon="sap-icon://dimension"
                        type="Transparent"
                        visible="{/canViewWeighbridgeOps}"
                        press=".onNavWeighbridgeOps" />
                    <Button
                        text="Factory Gate"
                        icon="sap-icon://factory"
                        type="Transparent"
                        visible="{/canViewFactoryGateOps}"
                        press=".onNavFactoryGateOps" />
                    <Button
                        text="Gate IN"
                        icon="sap-icon://log-in"
                        type="Emphasized"
                        tooltip="Register New Vehicle Entry"
                        visible="{/canCreateGateIn}"
                        press=".onOpenGateIn" />
                    <Button
                        text="Gate Exit"
                        icon="sap-icon://log-out"
                        type="Success"
                        tooltip="Authorize Final Vehicle Exit"
                        visible="{/canMainGateOut}"
                        press=".onOpenGateOut" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <VBox>
                    <MessageStrip
                        text="Main Gate Station: Register arriving vehicles (Gate IN), monitor real-time plant progression across stations, and authorize final Gate Exit clearance."
                        type="Information"
                        showIcon="true"
                        class="sapUiTinyMarginBottom" />
                    <HBox wrap="Wrap" class="fiori-header-kpi-row">
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Total Passes" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${/counts/TOTAL} || 0 }" emphasized="true" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Main Gate IN" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${/counts/GATE_IN} || 0 }" state="Information" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Active In Plant" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${/counts/IN_PLANT} || 0 }" state="Warning" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Ready for Exit" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${/counts/READY_OUT} || 0 }" state="Success" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Completed Exits" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${/counts/COMPLETED} || 0 }" state="Success" />
                        </VBox>
                    </HBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox class="fiori-page-container">
                <VBox class="fiori-table-card">
                    <Table
                        id="quickTxTable"
                        sticky="ColumnHeaders,HeaderToolbar"
                        alternateRowColors="true"
                        popinLayout="GridSmall"
                        growing="true"
                        growingThreshold="20"
                        noDataText="No gate entries match the selected filter or search criteria."
                        items="{/transactions}">
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <Title text="Gate Entries ({= ${/transactions} ? ${/transactions}.length : 0 })" level="H3" />
                                <ToolbarSpacer />
                                <SegmentedButton
                                    id="opsFilterSegmentedBtn"
                                    selectedKey="ALL"
                                    selectionChange=".onFilterCategoryChange">
                                    <items>
                                        <SegmentedButtonItem key="ALL" text="All ({= ${/counts/TOTAL} || 0 })" />
                                        <SegmentedButtonItem key="GATE_IN" text="IN ({= ${/counts/GATE_IN} || 0 })" />
                                        <SegmentedButtonItem key="IN_PLANT" text="In Plant ({= ${/counts/IN_PLANT} || 0 })" />
                                        <SegmentedButtonItem key="READY_OUT" text="Ready Exit ({= ${/counts/READY_OUT} || 0 })" />
                                        <SegmentedButtonItem key="COMPLETED" text="Exit ({= ${/counts/COMPLETED} || 0 })" />
                                    </items>
                                </SegmentedButton>
                                <SearchField
                                    id="opsSearchField"
                                    width="240px"
                                    placeholder="Search Vehicle, Pass, Driver..."
                                    liveChange=".onSearchLiveChange"
                                    search=".onSearch" />
                                <Button
                                    icon="sap-icon://clear-filter"
                                    type="Transparent"
                                    tooltip="Reset Search &amp; Filters"
                                    press=".onResetSearch" />
                                <ToolbarSeparator />
                                <Button
                                    icon="sap-icon://refresh"
                                    type="Transparent"
                                    tooltip="Refresh Gate Entries Queue"
                                    press=".onRefreshQueue" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="220px"><header><Text text="Vehicle / Pass" /></header></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><header><Text text="Driver" /></header></Column>
                            <Column width="180px"><header><Text text="Status / Stage" /></header></Column>
                            <Column width="190px" minScreenWidth="Desktop" demandPopin="true"><header><Text text="Time (IN / Exit)" /></header></Column>
                            <Column hAlign="End" width="210px"><header><Text text="Actions" /></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onTxRowPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{vehicleRegNo}"
                                        text="{gateInNumber} • {path: 'purpose', formatter: '.formatter.getPurposeText'}" />
                                    <Text text="{= ${driverName} || '-' }" />
                                    <VBox>
                                        <ObjectStatus
                                            text="{path: 'status', formatter: '.formatter.getStatusText'}"
                                            state="{path: 'status', formatter: '.formatter.getStatusState'}"
                                            inverted="true" />
                                        <Text
                                            text="{path: 'currentStage', formatter: '.formatter.getStageText'}"
                                            class="sapUiTinyMarginTop text-muted" />
                                    </VBox>
                                    <VBox>
                                        <Text text="{path: 'gateInDateTime', formatter: '.formatter.formatDateTime'}" />
                                        <Text
                                            text="{path: 'gateOutDateTime', formatter: '.formatter.formatDateTime'}"
                                            visible="{= !!${gateOutDateTime} }"
                                            class="sapUiTinyMarginTop text-muted" />
                                    </VBox>
                                    <HBox justifyContent="End" alignItems="Center" wrap="NoWrap">
                                        <!-- Final Exit button: ONLY shown and clickable if all other operations are performed completely (status: SECURITY_OUT) -->
                                        <Button
                                            text="Exit"
                                            icon="sap-icon://log-out"
                                            type="Success"
                                            tooltip="Authorize and record final Main Gate Exit clearance"
                                            visible="{= ${status} === 'SECURITY_OUT' }"
                                            enabled="{= ${status} === 'SECURITY_OUT' }"
                                            press=".onRowGateOutPress"
                                            class="sapUiTinyMarginEnd" />

                                        <!-- Exited Status Badge -->
                                        <ObjectStatus
                                            text="Exited"
                                            state="Success"
                                            inverted="true"
                                            icon="sap-icon://sys-enter-2"
                                            visible="{= ${status} === 'COMPLETED' }"
                                            class="sapUiTinyMarginEnd" />

                                        <Button
                                            icon="sap-icon://print"
                                            type="Transparent"
                                            tooltip="Print Gate Pass"
                                            press=".onTxPrintPress" />
                                        <Button
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="Edit Gate Entry"
                                            press=".onTxEditPress" />
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="Delete Gate Entry"
                                            visible="{= ${status} === 'GATE_IN' || ${status} === 'CANCELLED' }"
                                            press=".onTxDeletePress" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
