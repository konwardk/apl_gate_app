<mvc:View
    controllerName="factory.gate.controller.FactoryOperations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" enableScrolling="true">
        <!-- Subtoolbar matching Main Gate and Security Gate stations -->
        <OverflowToolbar class="fe-subtoolbar">
            <Button
                text="Back to Launchpad"
                icon="sap-icon://nav-back"
                type="Emphasized"
                press=".onNavBack" />
            <ToolbarSpacer />
            <Title text="Factory Gate Operations (Yard Entry &amp; Exit Clearance)" level="H2" titleStyle="H3" />
            <ToolbarSpacer />
            <Button
                text="Main Gate"
                icon="sap-icon://log-in"
                type="Default"
                visible="{/canViewMainGateOps}"
                press=".onNavMainGateOps" />
            <Button
                text="Security Gate"
                icon="sap-icon://shield"
                type="Default"
                visible="{/canViewSecurityGateOps}"
                press=".onNavSecurityGateOps" />
            <Button
                text="Weighbridge"
                icon="sap-icon://dimension"
                type="Default"
                visible="{/canViewWeighbridgeOps}"
                press=".onNavWeighbridgeOps" />
            <Button
                id="btnTopFactoryGateIn"
                text="Yard IN"
                icon="sap-icon://log-in"
                type="Emphasized"
                tooltip="Perform Factory Yard Check-In &amp; Unloading Arrival"
                press=".onOpenFactoryGateInDialog" />
            <Button
                id="btnTopFactoryGateOut"
                text="Yard Exit"
                icon="sap-icon://log-out"
                type="Success"
                tooltip="Authorize Factory Yard Exit &amp; Clearance"
                press=".onOpenFactoryGateOutDialog" />
        </OverflowToolbar>

        <VBox class="flp-dashboard">
            <!-- Context Banner -->
            <MessageStrip
                text="Factory Gate Station: Check-in security-cleared delivery and pickup vehicles into the yard (Factory Gate IN), record cargo unloading/loading, and authorize exit gate passes upon clearance (Factory Gate OUT - Standard, RGP, NRGP)."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

            <!-- Factory Yard Operational Queue Table -->
            <Table
                id="factoryTxTable"
                growing="true"
                growingThreshold="20"
                noDataText="No security-cleared vehicles in factory queue"
                items="{facModel>/displayedRecords}"
                class="sapUiMediumMarginTop">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Factory Yard Delivery Records ({= ${facModel>/displayedRecords} ? ${facModel>/displayedRecords}.length : 0 })" />
                        <ToolbarSpacer />
                        <SegmentedButton
                            id="facFilterSegmentedBtn"
                            selectedKey="{facModel>/selectedFilter}"
                            selectionChange=".onFilterCategoryChange">
                            <items>
                                <SegmentedButtonItem key="ALL" text="All ({= ${facModel>/allCount} })" />
                                <SegmentedButtonItem key="WAITING_IN" text="Awaiting IN ({= ${facModel>/waitingInCount} })" />
                                <SegmentedButtonItem key="INSIDE_YARD" text="Inside Yard ({= ${facModel>/insideYardCount} })" />
                                <SegmentedButtonItem key="YARD_DONE" text="Yard Done ({= ${facModel>/yardDoneCount} })" />
                            </items>
                        </SegmentedButton>
                        <SearchField
                            id="facSearchField"
                            width="260px"
                            placeholder="Search Vehicle, Pass, PO..."
                            liveChange=".onSearchLiveChange"
                            search=".onSearch" />
                        <Button
                            icon="sap-icon://clear-filter"
                            tooltip="Reset Search &amp; Filters"
                            press=".onResetSearch" />
                        <ToolbarSeparator />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Queue"
                            press=".onRefreshQueue" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><header><Text text="Gate IN # / Vehicle" /></header></Column>
                    <Column><header><Text text="Driver / Transporter" /></header></Column>
                    <Column><header><Text text="Delivery Flow" /></header></Column>
                    <Column><header><Text text="PO &amp; Supplier" /></header></Column>
                    <Column><header><Text text="Yard IN" /></header></Column>
                    <Column><header><Text text="Yard Exit" /></header></Column>
                    <Column><header><Text text="Status / Stage" /></header></Column>
                    <Column hAlign="End" width="340px"><header><Text text="Actions" /></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTxRowPress">
                        <cells>
                            <!-- 1. Gate IN # & Vehicle -->
                            <VBox>
                                <ObjectIdentifier
                                    title="{facModel>gateInNumber}"
                                    text="{facModel>vehicleRegNo}" />
                            </VBox>

                            <!-- 2. Driver & Transporter -->
                            <VBox>
                                <Text text="{= ${facModel>driverName} || '-' }" design="Bold" />
                                <Text text="{= ${facModel>transporter/transporterName} || ${facModel>factoryEntry/transporterName} || '-' }" class="sapUiTinyMarginTop text-muted" />
                            </VBox>

                            <!-- 3. Delivery Flow & Inbound Weight -->
                            <VBox>
                                <ObjectStatus
                                    text="{facModel>deliveryFlowDesc}"
                                    state="{facModel>deliveryFlowState}" />
                                <Text
                                    text="{= ${facModel>inboundWeightFormatted} ? 'Gross: ' + ${facModel>inboundWeightFormatted} : 'No Scale (Direct)' }"
                                    class="sapUiTinyMarginTop text-muted" />
                            </VBox>

                            <!-- 4. PO Number & Supplier -->
                            <VBox>
                                <Text
                                    text="{= ${facModel>factoryEntry/poNumber} || ${facModel>securityEntry/poNumber} || ${facModel>deliveryDetails/poNumber} || 'Without PO' }"
                                    design="Bold" />
                                <Text
                                    text="{= ${facModel>factoryEntry/supplierName} || ${facModel>supplier/supplierName} || ${facModel>securityEntry/supplierName} || '-' }"
                                    class="sapUiTinyMarginTop text-muted" />
                            </VBox>

                            <!-- 5. Yard IN -->
                            <VBox>
                                <Text
                                    text="{path: 'facModel>factoryEntry/factoryGateInDateTime', formatter: '.formatter.formatDateTime'}"
                                    design="Bold" />
                                <Text
                                    text="{= ${facModel>factoryEntry/factoryGateInOperator} ? 'Op: ' + ${facModel>factoryEntry/factoryGateInOperator} : (${facModel>isWaitingIn} ? 'Awaiting Check-In' : '-') }"
                                    class="sapUiTinyMarginTop text-muted" />
                                <Text
                                    text="{= ${facModel>factoryEntry/factoryArea} ? ${facModel>factoryEntry/factoryArea} + (${facModel>factoryEntry/unloadingPoint} ? ' (' + ${facModel>factoryEntry/unloadingPoint} + ')' : '') : '' }"
                                    class="sapUiTinyMarginTop text-muted"
                                    visible="{= Boolean(${facModel>factoryEntry/factoryArea}) }" />
                            </VBox>

                            <!-- 6. Yard Exit -->
                            <VBox>
                                <Text
                                    text="{path: 'facModel>factoryEntry/factoryGateOutDateTime', formatter: '.formatter.formatDateTime'}"
                                    design="Bold" />
                                <Text
                                    text="{= ${facModel>factoryEntry/factoryGateOutOperator} ? 'Op: ' + ${facModel>factoryEntry/factoryGateOutOperator} : '' }"
                                    visible="{= Boolean(${facModel>factoryEntry/factoryGateOutDateTime}) }"
                                    class="sapUiTinyMarginTop text-muted" />
                                <HBox alignItems="Center" class="sapUiTinyMarginTop" visible="{= Boolean(${facModel>factoryEntry/factoryGateOutDateTime}) }">
                                    <ObjectStatus
                                        text="{= ${facModel>factoryEntry/gateOutType} ? ${path: 'facModel>factoryEntry/gateOutType', formatter: '.formatter.getGateOutTypeDesc'} : ${path: 'facModel>factoryEntry/remarks', formatter: '.formatter.getGateOutTypeDesc'} }"
                                        state="{path: 'facModel>factoryEntry/gateOutType', formatter: '.formatter.getGateOutTypeState'}"
                                        icon="sap-icon://tag" />
                                </HBox>
                                <Text
                                    text="{= ${facModel>factoryEntry/unloadedQuantity} ? ${facModel>factoryEntry/unloadedQuantity} + ' ' + (${facModel>factoryEntry/quantityUnit} || 'KG') : '' }"
                                    class="sapUiTinyMarginTop text-muted"
                                    visible="{= Boolean(${facModel>factoryEntry/unloadedQuantity}) }" />
                                <Text
                                    text="{= ${facModel>isInsideYard} ? 'Inside Yard (Unloading)' : (!${facModel>factoryEntry/factoryGateOutDateTime} ? '-' : '') }"
                                    class="sapUiTinyMarginTop text-muted"
                                    visible="{= !Boolean(${facModel>factoryEntry/factoryGateOutDateTime}) }" />
                            </VBox>

                            <!-- 7. Status & Stage -->
                            <VBox>
                                <ObjectStatus
                                    text="{path: 'facModel>status', formatter: '.formatter.getStatusText'}"
                                    state="{path: 'facModel>status', formatter: '.formatter.getStatusState'}" />
                                <Text text="{path: 'facModel>currentStage', formatter: '.formatter.getStageText'}" class="sapUiTinyMarginTop text-muted" />
                            </VBox>

                            <!-- 8. Actions -->
                            <HBox justifyContent="End" class="sapUiTinyMarginBeginEnd">
                                <Button
                                    text="Yard IN"
                                    icon="sap-icon://log-in"
                                    type="Emphasized"
                                    tooltip="{= ${facModel>canRowFactoryIn} ? 'Record Yard Check-In for this vehicle' : 'Yard IN already completed' }"
                                    visible="{facModel>canRowFactoryIn}"
                                    enabled="{facModel>canRowFactoryIn}"
                                    press=".onRowFactoryInPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="Yard Exit"
                                    icon="sap-icon://log-out"
                                    type="Success"
                                    tooltip="{= ${facModel>canRowFactoryOut} ? 'Record Yard Exit &amp; Clearance for this vehicle' : 'Vehicle must complete Yard IN first' }"
                                    visible="{facModel>canRowFactoryOut}"
                                    enabled="{facModel>canRowFactoryOut}"
                                    press=".onRowFactoryOutPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="Print Pass"
                                    icon="sap-icon://print"
                                    type="Transparent"
                                    tooltip="Print Factory Gate OUT Pass"
                                    visible="{facModel>isYardDone}"
                                    press=".onRowPrintPress"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="View"
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    tooltip="View Consignment Details"
                                    press=".onRowViewPress" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
