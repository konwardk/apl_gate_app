<mvc:View
    controllerName="factory.gate.controller.SecurityOperations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage
        headerExpanded="true"
        showFooter="false"
        class="fiori-dynamic-page sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <Button
                        text="Launchpad"
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back to Launchpad"
                        press=".onNavBack" />
                </f:navigationActions>
                <f:heading>
                    <Title text="Security Gate Operations" level="H1" titleStyle="H3" />
                </f:heading>
                <f:expandedContent>
                    <Text text="Physical Inspection, Document Verification, Routing &amp; Exit Pass Clearance" class="text-muted" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="Security Inspection &amp; Clearance ({= ${secModel>/allRecordsCount} || 0 } records)" class="text-muted" />
                </f:snappedContent>
                <f:actions>
                    <Button
                        text="Main Gate"
                        icon="sap-icon://log-in"
                        type="Transparent"
                        visible="{/canViewMainGateOps}"
                        press=".onNavMainGateOps" />
                    <Button
                        text="Weighbridge"
                        icon="sap-icon://dimension"
                        type="Transparent"
                        visible="{/canViewWeighbridgeOps}"
                        press=".onNavWeighbridgeOps" />
                    <Button
                        text="Factory Gate"
                        icon="sap-icon://factory"
                        type="Transparent"
                        visible="{/canViewFactoryGateOps}"
                        press=".onNavFactoryGateOps" />
                    <Button
                        id="btnTopSecGateIn"
                        text="Security IN"
                        icon="sap-icon://shield"
                        type="Emphasized"
                        tooltip="Perform Inbound Security Check &amp; PO/Invoice Verification"
                        press=".onOpenSecurityGateInDialog" />
                    <Button
                        id="btnTopSecGateOut"
                        text="Security Exit"
                        icon="sap-icon://log-out"
                        type="Success"
                        tooltip="Perform Outbound Security Check &amp; Exit Pass Clearance"
                        press=".onOpenSecurityGateOutDialog" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <VBox>
                    <MessageStrip
                        text="Security Gate Station: Vehicle physical inspection, driver verification, consignment PO/invoice clearance (Security Gate IN), and exit gate pass authorization (Security Gate OUT)."
                        type="Information"
                        showIcon="true"
                        class="sapUiTinyMarginBottom" />
                    <HBox wrap="Wrap" class="fiori-header-kpi-row">
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="All Records" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${secModel>/allRecordsCount} || 0 }" emphasized="true" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Awaiting IN" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${secModel>/waitingInCount} || 0 }" state="Warning" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="In Plant" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${secModel>/inPlantCount} || 0 }" state="Information" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Awaiting Exit" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${secModel>/waitingOutCount} || 0 }" state="Warning" />
                        </VBox>
                        <VBox class="fiori-header-kpi-chip">
                            <Label text="Exit Cleared" class="fiori-facet-label" />
                            <ObjectNumber number="{= ${secModel>/clearedCount} || 0 }" state="Success" />
                        </VBox>
                    </HBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox class="fiori-page-container">
                <VBox class="fiori-table-card">
                    <Table
                        id="secTxTable"
                        sticky="ColumnHeaders,HeaderToolbar"
                        alternateRowColors="true"
                        popinLayout="GridSmall"
                        growing="true"
                        growingThreshold="20"
                        noDataText="No security gate records match the current filter criteria."
                        items="{secModel>/displayedRecords}">
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <Title text="Security Gate Records ({= ${secModel>/displayedRecords}.length })" level="H3" />
                                <ToolbarSpacer />
                                <SegmentedButton
                                    id="secFilterSegmentedBtn"
                                    selectedKey="{secModel>/selectedFilter}"
                                    selectionChange=".onFilterCategoryChange">
                                    <items>
                                        <SegmentedButtonItem key="ALL" text="All ({= ${secModel>/allRecordsCount} })" />
                                        <SegmentedButtonItem key="WAITING_IN" text="Awaiting IN ({= ${secModel>/waitingInCount} })" />
                                        <SegmentedButtonItem key="IN_PLANT" text="In Plant ({= ${secModel>/inPlantCount} })" />
                                        <SegmentedButtonItem key="WAITING_OUT" text="Awaiting Exit ({= ${secModel>/waitingOutCount} })" />
                                        <SegmentedButtonItem key="CLEARED" text="Exit Cleared ({= ${secModel>/clearedCount} })" />
                                    </items>
                                </SegmentedButton>
                                <SearchField
                                    id="secSearchField"
                                    width="240px"
                                    placeholder="Search Vehicle, Pass, Driver..."
                                    liveChange=".onSearchLiveChange"
                                    search=".onSearch" />
                                <Button
                                    icon="sap-icon://clear-filter"
                                    type="Transparent"
                                    tooltip="Reset Search &amp; Filters"
                                    press=".onResetSearch" />
                                <ToolbarSeparator />
                                <Button
                                    icon="sap-icon://refresh"
                                    type="Transparent"
                                    tooltip="Refresh Security Queue"
                                    press=".onRefreshQueue" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="150px"><header><Text text="Gate IN # / Vehicle" /></header></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><header><Text text="Driver / License" /></header></Column>
                            <Column width="110px"><header><Text text="Purpose" /></header></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><header><Text text="Security IN" /></header></Column>
                            <Column minScreenWidth="Desktop" demandPopin="true"><header><Text text="Security Exit" /></header></Column>
                            <Column minScreenWidth="Desktop" demandPopin="true"><header><Text text="Docs / Pass" /></header></Column>
                            <Column width="165px"><header><Text text="Status / Stage" /></header></Column>
                            <Column hAlign="End" width="320px"><header><Text text="Actions" /></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onTxRowPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{secModel>gateInNumber}"
                                        text="{secModel>vehicleRegNo}" />

                                    <VBox>
                                        <Text text="{= ${secModel>driverName} || ${secModel>driver/driverName} || '-' }" class="fiori-text-strong" />
                                        <Text
                                            text="{= 'DL: ' + (${secModel>securityEntry/driverLicenseNo} || ${secModel>driver/drivingLicenseNo} || 'Pending') }"
                                            class="sapUiTinyMarginTop text-muted" />
                                    </VBox>

                                    <ObjectStatus
                                        text="{path: 'secModel>purpose', formatter: '.formatter.getPurposeText'}"
                                        state="{path: 'secModel>purpose', formatter: '.formatter.getPurposeState'}"
                                        inverted="true" />

                                    <VBox>
                                        <Text
                                            visible="{= !!${secModel>securityEntry/securityInDateTime} }"
                                            text="{path: 'secModel>securityEntry/securityInDateTime', formatter: '.formatter.formatDateTime'}" />
                                        <ObjectStatus
                                            visible="{= !!${secModel>securityEntry/securityInDateTime} }"
                                            text="{= 'Officer: ' + (${secModel>securityEntry/securityPersonnel} || '-') }"
                                            state="Success"
                                            class="sapUiTinyMarginTop" />
                                        <ObjectStatus
                                            visible="{= !${secModel>securityEntry/securityInDateTime} }"
                                            text="Pending IN"
                                            state="Warning"
                                            inverted="true" />
                                    </VBox>

                                    <VBox>
                                        <Text
                                            visible="{= !!${secModel>securityEntry/securityOutDateTime} }"
                                            text="{path: 'secModel>securityEntry/securityOutDateTime', formatter: '.formatter.formatDateTime'}" />
                                        <ObjectStatus
                                            visible="{= !!${secModel>securityEntry/securityOutDateTime} }"
                                            text="{= 'Officer: ' + (${secModel>securityEntry/securityOutPersonnel} || '-') }"
                                            state="Success"
                                            class="sapUiTinyMarginTop" />
                                        <ObjectStatus
                                            visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; (${secModel>status} === 'WEIGHBRIDGE_OUT' || ${secModel>status} === 'FACTORY_OUT') }"
                                            text="Awaiting Exit"
                                            state="Warning"
                                            inverted="true" />
                                        <ObjectStatus
                                            visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; ${secModel>status} === 'SECURITY_IN' }"
                                            text="Direct Exit / Factory Ready"
                                            state="Information" />
                                        <ObjectStatus
                                            visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; (${secModel>status} === 'WEIGHBRIDGE_IN' || ${secModel>status} === 'FACTORY_IN') }"
                                            text="In Plant"
                                            state="Information" />
                                        <Text
                                            visible="{= !${secModel>securityEntry/securityOutDateTime} &amp;&amp; ${secModel>status} === 'GATE_IN' }"
                                            text="-"
                                            class="text-muted" />
                                    </VBox>

                                    <VBox>
                                        <Text
                                            text="{= ${secModel>securityEntry/poNumber} ? ('PO: ' + ${secModel>securityEntry/poNumber}) : (${secModel>securityEntry/rgpDocumentNo} ? ('RGP: ' + ${secModel>securityEntry/rgpDocumentNo}) : (${secModel>securityEntry/exitGatePassDocumentNo} ? ('Exit Pass: ' + ${secModel>securityEntry/exitGatePassDocumentNo}) : (${secModel>securityEntry/withoutPO} ? 'Without PO' : '-'))) }" />
                                        <Text
                                            text="{= ${secModel>securityEntry/invoiceNumber} ? ('Inv: ' + ${secModel>securityEntry/invoiceNumber}) : '' }"
                                            visible="{= !!${secModel>securityEntry/invoiceNumber} }"
                                            class="sapUiTinyMarginTop text-muted" />
                                    </VBox>

                                    <VBox>
                                        <ObjectStatus
                                            text="{path: 'secModel>status', formatter: '.formatter.getStatusText'}"
                                            state="{path: 'secModel>status', formatter: '.formatter.getStatusState'}"
                                            inverted="true" />
                                        <Text
                                            text="{path: 'secModel>currentStage', formatter: '.formatter.getStageText'}"
                                            class="sapUiTinyMarginTop text-muted" />
                                        <ObjectStatus
                                            visible="{= !!${secModel>assignedRoute} }"
                                            text="{= ${secModel>assignedRoute} === 'WEIGHBRIDGE' ? 'Route: Scale' : (${secModel>assignedRoute} === 'FACTORY' ? 'Route: Yard' : ${secModel>assignedRoute}) }"
                                            state="{= ${secModel>assignedRoute} === 'WEIGHBRIDGE' ? 'Information' : 'Success' }"
                                            class="sapUiTinyMarginTop" />
                                        <ObjectStatus
                                            visible="{= !${secModel>assignedRoute} &amp;&amp; ${secModel>status} === 'SECURITY_IN' }"
                                            text="Route: Pending"
                                            state="Warning"
                                            class="sapUiTinyMarginTop" />
                                    </VBox>

                                    <HBox justifyContent="End" alignItems="Center" wrap="NoWrap">
                                        <Button
                                            text="IN"
                                            icon="sap-icon://shield"
                                            type="Emphasized"
                                            tooltip="Process Security IN"
                                            visible="{secModel>canSecurityGateIn}"
                                            press=".onRowGateInPress"
                                            class="sapUiTinyMarginEnd" />

                                        <Button
                                            text="To Scale"
                                            icon="sap-icon://dimension"
                                            type="Default"
                                            tooltip="Assign Route: Send vehicle to Weighbridge for scale weighment"
                                            visible="{secModel>canSendToWeighbridge}"
                                            press=".onRowSendToWeighbridgePress"
                                            class="sapUiTinyMarginEnd" />
                                        <Button
                                            text="To Yard"
                                            icon="sap-icon://factory"
                                            type="Emphasized"
                                            tooltip="Assign Route: Send vehicle directly to Factory Yard"
                                            visible="{secModel>canSendToFactory}"
                                            press=".onRowSendToFactoryPress"
                                            class="sapUiTinyMarginEnd" />

                                        <Button
                                            text="At Scale"
                                            icon="sap-icon://dimension"
                                            type="Information"
                                            tooltip="Assigned to Weighbridge. Click to navigate to Weighbridge Operations."
                                            visible="{secModel>isAtWeighbridge}"
                                            press=".onRowNavToWeighbridge"
                                            class="sapUiTinyMarginEnd" />
                                        <Button
                                            text="At Yard"
                                            icon="sap-icon://factory"
                                            type="Information"
                                            tooltip="Assigned to Factory Gate. Click to navigate to Factory Operations."
                                            visible="{secModel>isAtFactory}"
                                            press=".onRowNavToFactory"
                                            class="sapUiTinyMarginEnd" />

                                        <Button
                                            text="Exit"
                                            icon="sap-icon://log-out"
                                            type="Success"
                                            tooltip="Process Security Exit Clearance"
                                            visible="{secModel>canSecurityGateOut}"
                                            press=".onRowGateOutPress"
                                            class="sapUiTinyMarginEnd" />

                                        <ObjectStatus
                                            text="Exit Cleared"
                                            state="Success"
                                            inverted="true"
                                            icon="sap-icon://sys-enter-2"
                                            visible="{secModel>isCleared}"
                                            class="sapUiTinyMarginEnd" />

                                        <Button
                                            icon="sap-icon://print"
                                            type="Transparent"
                                            tooltip="Print Gate Pass"
                                            press=".onRowPrintPress" />
                                        <Button
                                            icon="sap-icon://detail-view"
                                            type="Transparent"
                                            tooltip="View Details"
                                            press=".onRowDetailPress" />
                                        <Button
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="Edit Gate Entry"
                                            press=".onRowEditPress" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
