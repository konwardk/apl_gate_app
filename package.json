{
  "name": "apl-gate-app",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node test/gate-crud.test.js && node test/security-gate.test.js && node test/weighbridge.test.js && node test/gate-out.test.js && node test/security-gate-out.test.js && node test/bypass-weighbridge.test.js && node test/entry-wise-edit.test.js && node test/factory-gate.test.js && node test/security-route-assign.test.js && node test/po-service.test.js && node test/user-management.test.js && node test/auth-rbac-login.test.js"
  },
  "sapux": [
    "app/gate-entry",
    "app"
  ],
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "superadmin_user": { "password": "password", "roles": ["Superadmin", "Admin", "MainGateUser", "SecurityGateUser", "WeighbridgeUser", "FactoryGateUser", "Auditor"] },
          "maingate_user": { "password": "password", "roles": ["MainGateUser"] },
          "security_user": { "password": "password", "roles": ["SecurityGateUser"] },
          "weighbridge_user": { "password": "password", "roles": ["WeighbridgeUser"] },
          "factory_user": { "password": "password", "roles": ["FactoryGateUser"] },
          "admin_user": { "password": "password", "roles": ["Admin"] },
          "auditor_user": { "password": "password", "roles": ["Auditor"] }
        }
      },
      "CE_PURCHASEORDER_0001": {
        "kind": "odata-v4",
        "model": "srv/external/CE_PURCHASEORDER_0001",
        "credentials": {
          "destination": "S4HANA_CLOUD_PO"
        },
        "[development]": {
          "credentials": {
            "destination": "S4HANA_CLOUD_PO",
            "authentication": "BasicAuthentication",
            "username": "BTP_S4_INTEGRATION"
          }
        }
      }
    }
  }
}